{
  "name": "app2",
  "private": true,
  "type": "module",
  "description": "Flowvent — Plateforme SaaS d'organisation d'événements (abonnement simulé) — Nuxt 4 autonome",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "favicons": "node scripts/generate-favicons.mjs",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:detached": "docker compose -f docker-compose.dev.yml up -d --build",
    "docker:dev:detached:nocache": "docker compose -f docker-compose.dev.yml build --no-cache && docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:clean-modules": "docker compose -f docker-compose.dev.yml down && docker volume rm flowvent_node_modules && echo '✓ Volume node_modules supprimé. Relancez docker:dev pour réinstaller.'",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f flowvent-app",
    "docker:dev:exec": "docker compose -f docker-compose.dev.yml exec flowvent-app sh",
    "docker:dev:get-lockfile": "docker cp flowvent-app:/app/apps/app2/package-lock.json ./package-lock.json && echo '✓ package-lock.json copié depuis le conteneur'",
    "docker:dev:get-package": "docker cp flowvent-app:/app/apps/app2/package.json ./package.json && echo '✓ package.json copié depuis le conteneur'",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:release:up": "docker compose -f docker-compose.release.yml up -d --build",
    "docker:release:down": "docker compose -f docker-compose.release.yml down"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/luxon3": "^6.1.21",
    "@fullcalendar/resource": "^6.1.20",
    "@fullcalendar/resource-timeline": "^6.1.20",
    "@fullcalendar/timeline": "^6.1.20",
    "@fullcalendar/vue3": "^6.1.20",
    "@internationalized/date": "^3.12.4",
    "@nuxt/ui": "^4.12.2",
    "@nuxtjs/i18n": "^10.4.0",
    "@pinia/nuxt": "^0.11.3",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.8.0",
    "@tiptap/extension-emoji": "^3.35.0",
    "@vueuse/core": "^14.3.0",
    "@vvo/tzdb": "^6.204.0",
    "bcryptjs": "^3.0.3",
    "cron": "^4.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "libphonenumber-js": "^1.13.1",
    "luxon": "^3.7.2",
    "nuxt": "^4.7.0",
    "nuxt-auth-utils": "^0.5.29",
    "nuxt-file-storage": "^0.3.3",
    "nuxt-qrcode": "^0.4.10",
    "pinia": "^3.0.4",
    "prisma": "^7.10.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vue": "^3.5.46",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22 <26"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.116",
    "@iconify-json/simple-icons": "^1.2.89",
    "@nuxt/devtools": "^3.4.4",
    "png-to-ico": "^3.0.1",
    "sharp": "0.35.5"
  }
}
