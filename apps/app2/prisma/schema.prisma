// Schéma Prisma de Flowvent (app2, MySQL). Compte utilisateur (auth partagée via
// le layer layers/auth : email/mot de passe + OAuth Google), événements créés par
// l'utilisateur, et abonnement (paiement simulé) qui débloque l'organisation.
//
// Le model User reprend les champs attendus par le layer d'authentification
// (`layers/auth`) : pseudo unique, emailHash, password nullable (null pour OAuth),
// authProvider, vérification d'email, profilePicture (= avatar Google), etc.

generator client {
  provider = "prisma-client-js"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                     Int               @id @default(autoincrement())
  email                  String            @unique
  emailHash              String
  pseudo                 String            @unique
  nom                    String?
  prenom                 String?
  password               String? // nullable : null pour les comptes OAuth (Google)
  authProvider           String            @default("email") // "email" | "google" | "facebook" | "MANUAL"
  // Identifiants des fournisseurs OAuth : le layer d'auth retrouve le compte par eux au retour de
  // Google / Facebook. Sans ces colonnes, le retour OAuth échouait (requête Prisma invalide).
  googleId               String?           @unique
  facebookId             String?           @unique
  // Génération de session, écrite dans la session par le layer d'auth (même rôle que dans app1).
  sessionVersion         Int               @default(0)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  lastLoginAt            DateTime?
  profilePicture         String? // avatar (photo de profil Google)
  emailVerificationCode  String?
  isEmailVerified        Boolean           @default(false)
  verificationCodeExpiry DateTime?
  isGlobalAdmin          Boolean           @default(false)
  phone                  String?
  // Informations personnelles demandées par le formulaire de candidature bénévole (selon la
  // configuration de l'événement). Mêmes champs qu'app1 : le layer bénévoles les lit tels quels.
  pronouns               String?
  dietaryPreference      DietaryPreference @default(NONE)
  allergies              String?           @db.Text
  allergySeverity        AllergySeverity?
  emergencyContactName   String?
  emergencyContactPhone  String?
  preferredLanguage      String            @default("fr")
  isVolunteer            Boolean           @default(false)
  isArtist               Boolean           @default(false)
  isOrganizer            Boolean           @default(false)

  events              Event[]
  subscription        Subscription?
  passwordResetTokens PasswordResetToken[]
  promoCodeRedemptions PromoCodeRedemption[]

  // Gestion des bénévoles (relations inverses, mêmes noms qu'app1)
  volunteerApplications              EditionVolunteerApplication[]
  manuallyAddedVolunteers            EditionVolunteerApplication[]       @relation("ManuallyAddedVolunteers")
  volunteerNotificationGroups        VolunteerNotificationGroup[]
  volunteerNotificationConfirmations VolunteerNotificationConfirmation[]
  volunteerAssignments               VolunteerAssignment[]               @relation("VolunteerAssignment_user")
  volunteerSwapsRequested            VolunteerSwapRequest[]              @relation("VolunteerSwap_requester")
  volunteerSwapsReceived             VolunteerSwapRequest[]              @relation("VolunteerSwap_target")
  volunteerSwapsDecided              VolunteerSwapRequest[]              @relation("VolunteerSwap_decidedBy")
  assignedVolunteerSlots             VolunteerAssignment[]               @relation("VolunteerAssignment_assignedBy")
  volunteerAutoAssignRuns            VolunteerAutoAssignRun[]            @relation("VolunteerAutoAssignRun_executedBy")
  volunteerAutoAssignRunsUndone      VolunteerAutoAssignRun[]            @relation("VolunteerAutoAssignRun_undoneBy")
  volunteerAutoAssignPlans           VolunteerAutoAssignPlan[]           @relation("VolunteerAutoAssignPlan_createdBy")
  volunteerComments                  VolunteerComment[]
  notifications                      Notification[]
  organizers                         Organizer[]
  // Stock (layer `stock`) : responsables de retrait et de retour d'un article, réservations.
  stockPickupResponsibilities        StockItem[]                         @relation("StockPickupResponsible")
  stockReturnResponsibilities        StockItem[]                         @relation("StockReturnResponsible")
  stockReservations                  StockReservation[]
  // Artistes et spectacles (layer `artists`) : mêmes noms qu'app1.
  artistProfiles                     EditionArtist[]
  validatedArtistEntries             EditionArtist[]                     @relation("ArtistEntryValidator")
  artistPickupResponsibilities       EditionArtist[]                     @relation("ArtistPickupResponsible")
  artistDropoffResponsibilities      EditionArtist[]                     @relation("ArtistDropoffResponsible")
  showPresets                        ShowPreset[]
  artistNotificationGroups           ArtistNotificationGroup[]
  artistNotificationConfirmations    ArtistNotificationConfirmation[]
  showApplications                   ShowApplication[]
  decidedShowApplications            ShowApplication[]                   @relation("ShowApplicationDecider")
  showCallSurveyVotes                ShowCallSurveyVote[]
  apiErrorLogs                       ApiErrorLog[]
  ticketingCountersTouched           TicketingCounter[]                  @relation("TicketingCounterLastActor")
  entryValidationLogs                EntryValidationLog[]                @relation("EntryValidationLogActor")
  treasuryAdvances                   TreasuryEntry[]                     @relation("TreasuryAdvances")
  treasuryCashFloatLoans             TreasuryCashFloat[]                 @relation("TreasuryCashFloatLenders")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Event {
  id                               Int                  @id @default(autoincrement())
  /// Identifiant PUBLIC, celui des adresses (`/events/<publicId>/…`) : aléatoire, donc ni le
  /// nombre d'événements ni les pages publiques des autres ne se devinent en comptant. L'`id`
  /// numérique reste interne (relations, API du layer bénévoles).
  publicId                         String               @unique @default(nanoid(10)) @db.VarChar(16)
  name                             String
  description                      String?              @db.Text
  /// Nom du lieu (« Salle des fêtes de Lyon »). L'adresse postale est dans les colonnes address*.
  location                         String?
  /// Adresse postale du lieu, affichée sur la page publique (avec un lien vers la carte).
  addressLine1                     String?
  addressLine2                     String?
  postalCode                       String?  @db.VarChar(20)
  city                             String?
  country                          String?
  /// Affiche de l'événement (`/uploads/events/<id>/<fichier>`), publique.
  imageUrl                         String?
  /// Liens publics de l'événement.
  officialWebsiteUrl               String?  @db.VarChar(500)
  ticketingUrl                     String?  @db.VarChar(500)
  facebookUrl                      String?  @db.VarChar(500)
  instagramUrl                     String?  @db.VarChar(500)
  /// La page de l'événement (`/events/<publicId>`) est visible de tous, sans connexion. Choisi par
  /// l'organisateur : fermée par défaut, pour qu'aucun événement en préparation ne s'expose seul.
  pagePublique                     Boolean  @default(false)
  startDate                        DateTime?
  // Métadonnées génériques lues par le layer bénévoles (comme l'`Event` d'app1).
  endDate                          DateTime?
  status                           EditionStatus        @default(PUBLISHED)
  timezone                         String?
  /// Archivé : l'événement est passé en LECTURE SEULE complète par son propriétaire, et ne compte
  /// plus parmi ses événements en cours (le plafond de sa formule, shared/formules.ts).
  archivedAt                       DateTime?
  /// Alertes de plafond déjà envoyées au propriétaire, par compteur : `{ "benevoles": "alerte" }`
  /// (80 %) puis `"plein"` (limite atteinte). Un courriel par palier, jamais deux (quotas.ts).
  alertesQuota                     Json?
  /// Modules activés pour l'événement (page « Accueil de la gestion »), un par module comme les
  /// `*Enabled` d'une édition d'app1. Le module bénévoles est actif par défaut.
  volunteersEnabled                Boolean              @default(true)
  /// Les autres modules, inactifs par défaut comme dans app1 (cf. shared/modules-evenement.ts).
  siteMapEnabled                   Boolean              @default(false)
  stockEnabled                     Boolean              @default(false)
  artistsEnabled                   Boolean              @default(false)
  mealsEnabled                     Boolean              @default(false)
  ticketingEnabled                 Boolean              @default(false)
  treasuryEnabled                  Boolean              @default(false)
  /// Dernier comptage du fonds de caisse, en centimes, et sa date (trésorerie, comme l'édition d'app1).
  cashFloatCount                   Int?
  cashFloatCountedAt               DateTime?
  treasuryCodes                    TreasuryCode[]
  treasuryEntries                  TreasuryEntry[]
  treasurySourceCodes              TreasurySourceCode[]
  treasuryCashFloats               TreasuryCashFloat[]
  treasuryPayees                   TreasuryPayee[]
  /// Carte du site (layer `map`) : publique ou réservée à la gestion, et la carte externe
  /// (Google My Maps…) d'où l'on importe zones et repères. Mêmes colonnes que l'`Edition` d'app1.
  mapPublic                        Boolean              @default(false)
  externalMapProvider              String?
  externalMapRef                   String?
  /// Informations pratiques données aux artistes (espace artiste) — layer `artists`, comme
  /// `Edition.artistInfo` d'app1.
  artistInfo                       String?              @db.Text
  /// Réglages de la billetterie (layer `ticketing`), mêmes noms et défauts que l'`Edition` d'app1.
  ticketingAllowOnsiteRegistration Boolean              @default(true)
  ticketingAllowAnonymousOrders    Boolean              @default(false)
  ticketingPaymentCash             Boolean              @default(true)
  ticketingPaymentCard             Boolean              @default(true)
  ticketingPaymentCheck            Boolean              @default(true)
  ticketingSumupEnabled            Boolean              @default(false)
  ticketingHandoutItemsEnabled     Boolean              @default(true)
  createdAt                        DateTime             @default(now())
  updatedAt                        DateTime             @updatedAt
  owner                            User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId                          Int

  // Gestion des bénévoles (relations inverses, mêmes noms qu'app1)
  volunteerApplications          EditionVolunteerApplication[]
  volunteerTeams                 VolunteerTeam[]
  volunteerTimeSlots             VolunteerTimeSlot[]
  volunteerNotificationGroups    VolunteerNotificationGroup[]
  volunteerComments              VolunteerComment[]
  volunteerSwapRequests          VolunteerSwapRequest[]
  volunteerSettings              EventVolunteerSettings?
  volunteerAutoAssignRuns        VolunteerAutoAssignRun[]
  volunteerAutoAssignPlans       VolunteerAutoAssignPlan[]
  editionOrganizers              EditionOrganizer[]
  zones                          EditionZone[]
  markers                        EditionMarker[]
  stockGroups                    StockGroup[]
  stockTags                      StockTag[]
  stockShoppingLists             StockShoppingList[]
  artists                        EditionArtist[]
  shows                          Show[]
  artistNotificationGroups       ArtistNotificationGroup[]
  handoutItems                   TicketingHandoutItem[]
  volunteerMeals                 VolunteerMeal[]
  showCalls                      EditionShowCall[]
  externalTicketing              ExternalTicketing?
  sumupConfig                    SumupConfig?
  tiers                          TicketingTier[]
  ticketingQuotas                TicketingQuota[]
  options                        TicketingOption[]
  orders                         TicketingOrder[]
  volunteerTicketingHandoutItems EditionVolunteerHandoutItem[]
  organizerTicketingHandoutItems EditionOrganizerHandoutItem[]
  organizerTicketingQuotas       EditionOrganizerQuota[]
  volunteerTicketingQuotas       EditionVolunteerQuota[]
  artistTicketingQuotas          EditionArtistQuota[]
  artistTicketingHandoutItems    EditionArtistHandoutItem[]
  tierCustomFields               TicketingTierCustomField[]
  ticketingCounters              TicketingCounter[]
  entryValidationLogs            EntryValidationLog[]

  @@index([ownerId])
}

model Subscription {
  id               Int      @id @default(autoincrement())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           Int      @unique
  plan             String // "monthly" | "annual"
  status           String   @default("active") // "active" | "inactive"
  currentPeriodEnd DateTime
  formule          String   @default("association") // "association" | "festival" | "grand" (shared/formules.ts)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  promoCode        PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoCodeId      Int?
  advantageEndsAt  DateTime? // fin de l'avantage du code ; null avec un code : à vie
  amountPaid       Int? // centimes payés pour la période en cours (paiement simulé)
  endReminderFor   DateTime? // fin de période pour laquelle le rappel est parti (un seul par période)

  @@index([promoCodeId])
}

/// Code promo (shared/codes-promo.ts) : remise en pourcentage, montant retiré ou gratuité, sur des
/// formules et des périodes données, pour une durée donnée. Réglages calqués sur les coupons Stripe.
/// Un code utilisé ne se supprime pas : il se désactive (`active`), et ses bénéficiaires gardent
/// leur avantage jusqu'à son terme.
model PromoCode {
  id             Int                   @id @default(autoincrement())
  code           String                @unique @db.VarChar(64)
  label          String? // note interne de l'administration
  advantage      String // "percent" | "amount" | "free"
  value          Int                   @default(0) // pourcentage (1-100) ou centimes
  formules       Json? // formules visées ; null : toutes
  periods        Json? // "monthly" | "annual" ; null : les deux
  duration       String // "once" | "months" | "forever"
  durationMonths Int?
  startsAt       DateTime?
  expiresAt      DateTime?
  maxRedemptions Int?
  reservedEmail  String? // réservé à cette adresse ; null : tout le monde
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  redemptions    PromoCodeRedemption[]
  subscriptions  Subscription[]
}

/// Une utilisation d'un code par un compte (une seule par compte et par code).
model PromoCodeRedemption {
  id          Int       @id @default(autoincrement())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  promoCodeId Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  formule     String
  plan        String
  amountPaid  Int // centimes payés pour la première période
  createdAt   DateTime  @default(now())

  @@unique([promoCodeId, userId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Gestion des bénévoles — modèles du layer `layers/volunteers`, repris d'app1
// (apps/app1/prisma/schema/volunteer.prisma). Relations vers des modules que Flowvent n'a pas
// (repas, objets remis, quotas billetterie, conversations) retirées. Cf. docs/flowvent-benevoles.md.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

enum EditionStatus {
  PLANNED
  PUBLISHED
  OFFLINE
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

/// Notifications internes. Même forme qu'app1 : le layer bénévoles en crée et en lit.
model Notification {
  id                String           @id @default(cuid())
  userId            Int
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              NotificationType
  titleKey          String?
  messageKey        String?
  translationParams Json?
  actionTextKey     String?
  titleText         String?          @db.Text
  messageText       String?          @db.Text
  actionText        String?
  category          String?
  entityType        String?
  entityId          String?
  isRead            Boolean          @default(false)
  readAt            DateTime?
  actionUrl         String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([category])
  @@index([entityType, entityId])
}

/// Un organisateur de Flowvent (base des co-organisateurs). Le layer bénévoles ne lit que
/// `editionOrganizer.organizer.userId` / `.user` : le nom du modèle lui est indifférent.
model Organizer {
  id        Int                @id @default(autoincrement())
  userId    Int
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  editions  EditionOrganizer[]

  @@index([userId])
}

/// Organisateur affecté à un événement. Nom et champs d'app1 : le layer interroge
/// `prisma.editionOrganizer` et ses relations par ces noms. `editionId` désigne l'`Event`.
model EditionOrganizer {
  id                  Int                           @id @default(autoincrement())
  editionId           Int
  organizerId         Int
  /// Droits par domaine (décision de l'utilisateur : un droit par domaine, chaque module ajoute le
  /// sien). Le propriétaire de l'événement a tout, sans ligne ici.
  canEditEvent        Boolean                       @default(false)
  canManageOrganizers Boolean                       @default(false)
  canManageVolunteers Boolean                       @default(false)
  canManageStock      Boolean                       @default(false)
  canManageArtists    Boolean                       @default(false)
  canManageMeals      Boolean                       @default(false)
  canManageTicketing  Boolean                       @default(false)
  canManageTreasury   Boolean                       @default(false)
  arrivalDateTime     String?
  departureDateTime   String?
  qrCodeToken         String?                       @unique
  entryValidated      Boolean                       @default(false)
  entryValidatedAt    DateTime?
  entryValidatedBy    Int?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  event               Event                         @relation(fields: [editionId], references: [id], onDelete: Cascade)
  organizer           Organizer                     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  teamAssignments     OrganizerTeamAssignment[]
  slotAssignments     OrganizerSlotAssignment[]
  handoutItems        EditionOrganizerHandoutItem[]
  quotas              EditionOrganizerQuota[]
  mealSelections      OrganizerMealSelection[]

  @@unique([editionId, organizerId])
  @@index([editionId])
  @@index([organizerId])
}

enum VolunteerMode {
  INTERNAL
  EXTERNAL
}

enum DietaryPreference {
  NONE
  VEGETARIAN
  VEGAN
}

enum AllergySeverity {
  LIGHT
  MODERATE
  SEVERE
  CRITICAL
}

enum VolunteerStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum VolunteerApplicationSource {
  APPLICATION // Candidature spontanée via formulaire
  MANUAL // Ajout manuel par un organisateur
}

// Configuration bénévole d'un événement (1:1 avec Event), portée par le layer volunteers.
// Étape 0bis : extraite d'Edition pour que le module bénévole ne dépende plus du domaine jonglerie.
model EventVolunteerSettings {
  eventId Int   @id
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  enabled           Boolean       @default(false)
  open              Boolean       @default(false)
  pagePublic        Boolean       @default(false)
  mode              VolunteerMode @default(INTERNAL)
  // Les échanges de créneaux entre bénévoles, ouverts par défaut : les éditions existantes
  // gardent le comportement qu'elles avaient avant l'arrivée de ce réglage.
  swapsEnabled      Boolean       @default(true)
  // Rattacher des organisateurs aux équipes et créneaux. Fermé par défaut : c'est une
  // possibilité qu'on ouvre, pas un comportement que les éditions existantes attendaient.
  organizersInTeams Boolean       @default(false)
  // Le planning est-il montré aux bénévoles acceptés ?
  //
  // Fermé par défaut, et c'est l'inverse du raisonnement de `swapsEnabled` : un responsable
  // construit ses plannings par itérations, et voir apparaître puis disparaître ses créneaux au
  // fil de la journée donne à un bénévole des informations fausses qu'il notera dans son agenda.
  // Une édition neuve doit donc commencer masquée, et le responsable publier quand il juge prêt.
  //
  // ⚠️ La MIGRATION passe toutes les lignes EXISTANTES à `true`. Le défaut sert les éditions à
  // venir ; sans cet UPDATE, les éditions en cours perdraient du jour au lendemain un affichage
  // que leurs bénévoles ont déjà — y compris pendant une convention.
  planningPublished Boolean       @default(false)
  description       String?       @db.Text
  externalUrl       String?
  setupStartDate    DateTime?
  teardownEndDate   DateTime?
  updatedAt         DateTime?

  // Questions du formulaire de candidature
  askDiet             Boolean @default(false)
  askAllergies        Boolean @default(false)
  askTimePreferences  Boolean @default(false)
  askTeamPreferences  Boolean @default(false)
  askPets             Boolean @default(false)
  askMinors           Boolean @default(false)
  askVehicle          Boolean @default(false)
  askCompanion        Boolean @default(false)
  askAvoidList        Boolean @default(false)
  askSkills           Boolean @default(false)
  askExperience       Boolean @default(false)
  askEmergencyContact Boolean @default(false)
  askSetup            Boolean @default(false)
  askTeardown         Boolean @default(false)

  /// Les réglages de l'assignation automatique, partagés par les organisateurs de l'édition.
  ///
  /// Ils vivaient dans le `localStorage` du navigateur : changer de poste les faisait repartir
  /// aux valeurs par défaut sans prévenir — y compris le mode de conservation, qui décide de ce
  /// qui sera détruit. Et deux organisateurs pouvaient lancer le calcul avec des contraintes
  /// différentes sans le savoir, le résultat dépendant alors de qui avait cliqué.
  ///
  /// `null` signifie « jamais réglé » : l'écran part de ses valeurs par défaut, comme avant.
  autoAssignConstraints Json?
}

model EditionVolunteerApplication {
  id                   Int                         @id @default(autoincrement())
  eventId              Int
  userId               Int
  status               VolunteerStatus             @default(PENDING)
  motivation           String?                     @db.Text
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  decidedAt            DateTime?
  userSnapshotPhone    String?
  timePreferences      Json?
  teamPreferences      Json?
  acceptanceNote       String?                     @db.Text
  hasPets              Boolean?
  petsDetails          String?                     @db.Text
  hasMinors            Boolean?
  minorsDetails        String?                     @db.Text
  hasVehicle           Boolean?
  vehicleDetails       String?                     @db.Text
  companionName        String?                     @db.Text
  avoidList            String?                     @db.Text
  skills               String?                     @db.Text
  hasExperience        Boolean?
  experienceDetails    String?                     @db.Text
  setupAvailability    Boolean?
  teardownAvailability Boolean?
  eventAvailability    Boolean?
  arrivalDateTime      String?
  departureDateTime    String?
  qrCodeToken          String?                     @unique
  entryValidated       Boolean                     @default(false)
  entryValidatedAt     DateTime?
  entryValidatedBy     Int?
  source               VolunteerApplicationSource  @default(APPLICATION)
  addedById            Int?
  addedAt              DateTime?
  event                Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedBy              User?                       @relation("ManuallyAddedVolunteers", fields: [addedById], references: [id], onDelete: SetNull)
  teamAssignments      ApplicationTeamAssignment[]
  mealSelections       VolunteerMealSelection[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([status])
  @@index([userId], map: "EditionVolunteerApplication_userId_fkey")
  @@index([entryValidated])
  @@index([source])
  @@index([addedById])
  @@index([qrCodeToken])
}

model VolunteerNotificationGroup {
  id             String   @id @default(cuid())
  eventId        Int
  /// Facultatif depuis que la suppression de compte le met à nul : l'envoi reste, son auteur non.
  /// Le message a été reçu, et l'effacer avec son expéditeur réécrirait l'histoire de l'édition.
  senderId       Int?
  title          String
  message        String   @db.Text
  targetType     String // 'all' ou 'teams'
  selectedTeams  Json? // Array des équipes sélectionnées si targetType = 'teams'
  recipientCount Int
  sentAt         DateTime @default(now())

  event         Event                               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sender        User?                               @relation(fields: [senderId], references: [id], onDelete: SetNull)
  confirmations VolunteerNotificationConfirmation[]

  @@index([eventId])
  @@index([senderId])
}

model VolunteerNotificationConfirmation {
  id                           String    @id @default(cuid())
  volunteerNotificationGroupId String
  userId                       Int
  confirmedAt                  DateTime?

  notificationGroup VolunteerNotificationGroup @relation(fields: [volunteerNotificationGroupId], references: [id], onDelete: Cascade)
  /// Cascade : un accusé de lecture est une ligne PAR DESTINATAIRE. Le destinataire parti, elle ne
  /// dit plus rien — et sans action de suppression, la relation étant obligatoire, Prisma applique
  /// `Restrict` et la suppression du compte échouait en P2003.
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([volunteerNotificationGroupId, userId])
  @@index([userId])
}

model VolunteerTeam {
  id                    String   @id @default(cuid())
  eventId               Int
  name                  String
  description           String?  @db.Text
  color                 String   @default("#6b7280") @db.VarChar(7)
  maxVolunteers         Int?
  isRequired            Boolean  @default(false)
  isAccessControlTeam   Boolean  @default(false)
  isMealValidationTeam  Boolean  @default(false)
  /// Équipe de bénévoles VOLANTS : des gens à disposition, sans créneau fixe, qu'on appelle en
  /// renfort quand une équipe prend du retard ou qu'une tâche se révèle plus lourde que prévu.
  ///
  /// La notion vit sur l'ÉQUIPE et non sur le bénévole, et c'est ce qui la rend peu coûteuse :
  /// être volant, c'est simplement appartenir à une telle équipe. Le rattachement existe déjà
  /// (`ApplicationTeamAssignment`), les objets à remettre sont déjà portés par l'équipe, et la
  /// conversation d'équipe permet déjà de joindre tout le monde pendant l'événement.
  ///
  /// ⚠️ Elle n'exempte de rien à elle seule. Un bénévole n'est « hors des comptes » que si TOUTES
  /// ses équipes sont volantes : quelqu'un qui est à la fois en cuisine et volant reste un
  /// bénévole ordinaire, et l'assignation automatique lui donne ses heures de cuisine. Voir
  /// `benevoles-volants.ts`, où la règle est écrite une fois.
  isFloatingTeam        Boolean  @default(false)
  /// Équipe AUTONOME : elle se gère à part, et réserve ses membres.
  ///
  /// Ses créneaux ne comptent pas dans les heures à pourvoir et ne sont pas remplis par
  /// l'assignation automatique — elle s'organise elle-même. Et les bénévoles qui n'appartiennent
  /// qu'à des équipes autonomes ne reçoivent aucun créneau d'ailleurs : ils lui sont réservés.
  ///
  /// ⚠️ À ne pas confondre avec `isFloatingTeam`, dont l'effet sur l'ÉQUIPE est le même mais dont
  /// l'effet sur les PERSONNES est inverse : la volante libère ses membres de leur volume
  /// d'heures et les propose en renfort, l'autonome les garde tenus à leurs heures et les tient
  /// hors de la page des renforts. Voir `benevoles-volants.ts`, où les deux règles cohabitent.
  isAutonomousTeam      Boolean  @default(false)
  /// Les PÉRIODES sur lesquelles l'équipe intervient — montage, événement, démontage.
  ///
  /// Une équipe d'accueil peut n'exister que pendant l'événement, une équipe de chantier
  /// seulement au montage et au démontage. Le formulaire de candidature ne propose alors, dans les
  /// équipes préférées, que celles dont une période recoupe les disponibilités annoncées par le
  /// bénévole : demander à quelqu'un qui ne vient qu'au montage s'il préfère l'équipe de plonge du
  /// dimanche soir n'avait pas de sens, et son choix n'aurait servi à personne.
  ///
  /// `true` par défaut sur les trois : l'`ALTER` remplit ainsi les équipes existantes, qui gardent
  /// donc exactement le comportement qu'elles avaient. Aucune édition en cours ne change.
  ///
  /// ⚠️ Au moins une période doit rester cochée — une équipe qui ne couvre rien ne serait proposée
  /// à personne. Les deux points d'API le refusent.
  coversSetup           Boolean  @default(true)
  coversEvent           Boolean  @default(true)
  coversTeardown        Boolean  @default(true)
  isVisibleToVolunteers Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  event                Event                         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  timeSlots            VolunteerTimeSlot[]
  assignedApplications ApplicationTeamAssignment[]
  assignedOrganizers   OrganizerTeamAssignment[]
  handoutItems         EditionVolunteerHandoutItem[]
  ticketingQuotas      EditionVolunteerQuota[]

  @@index([eventId])
}

model VolunteerTimeSlot {
  id            String   @id @default(cuid())
  eventId       Int
  teamId        String?
  title         String?
  description   String?  @db.Text
  startDateTime DateTime
  endDateTime   DateTime
  maxVolunteers Int      @default(1)
  delayMinutes  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event                Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team                 VolunteerTeam?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignments          VolunteerAssignment[]
  organizerAssignments OrganizerSlotAssignment[]

  @@index([eventId])
  @@index([teamId])
}

/// D'où vient une affectation : posée à la main, ou produite par l'assignation automatique.
/// `assignedById` ne peut pas en tenir lieu — l'organisateur qui lance le calcul y figure
/// comme s'il avait tout posé lui-même.
///
/// Sert aux deux choses que l'assignation automatique écrit, et qu'elle doit donc pouvoir
/// reprendre sans écraser de décision humaine : l'affectation à un créneau
/// (`VolunteerAssignment`) et le rattachement à une équipe (`ApplicationTeamAssignment`).
enum VolunteerAssignmentSource {
  MANUAL
  AUTO
}

model VolunteerAssignment {
  id           String                    @id @default(cuid())
  timeSlotId   String
  userId       Int
  assignedAt   DateTime                  @default(now())
  assignedById Int
  // Par défaut manuelle : c'est le choix prudent pour les lignes déjà en base, dont l'origine
  // est perdue, et une relance ne doit pas les balayer par surprise.
  source       VolunteerAssignmentSource @default(MANUAL)

  /// Quand le rappel « votre créneau commence dans 30 minutes » a été envoyé pour cette
  /// affectation. `null` = jamais.
  ///
  /// ⚠️ SANS CETTE MARQUE, LE RAPPEL PARTAIT 4 À 5 FOIS. La tâche tourne CHAQUE MINUTE et retient
  /// les créneaux qui démarrent dans 28 à 32 minutes : un même créneau tombe donc dans la fenêtre
  /// à quatre ou cinq passages consécutifs, et rien ne gardait trace de l'envoi précédent.
  ///
  /// Portée par l'AFFECTATION et non par le créneau : quelqu'un affecté entre deux passages doit
  /// recevoir son rappel, ce qu'une marque posée sur le créneau lui aurait retiré.
  reminderSentAt DateTime?

  timeSlot       VolunteerTimeSlot      @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  user           User                   @relation("VolunteerAssignment_user", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy     User                   @relation("VolunteerAssignment_assignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  swapsOffered   VolunteerSwapRequest[] @relation("VolunteerSwap_requesterAssignment")
  swapsRequested VolunteerSwapRequest[] @relation("VolunteerSwap_targetAssignment")

  @@unique([timeSlotId, userId])
  @@index([timeSlotId])
  @@index([userId])
  @@index([assignedById])
  // La relance efface les affectations automatiques d'une édition : cet index évite un
  // balayage complet de la table pour les retrouver.
  @@index([source])
}

/// Le journal d'une application de l'assignation automatique, et de quoi la défaire.
///
/// Le calcul écrit des centaines de lignes d'un coup et n'en gardait aucune trace : ni les
/// réglages employés, ni ce qu'il avait effacé, ni qui l'avait lancé — deux `console.log` en tout.
/// Un organisateur qui se trompait de mode n'avait aucun moyen de revenir en arrière.
///
/// L'état antérieur est conservé en JSON plutôt qu'en tables filles, et c'est délibéré : il est
/// écrit d'un bloc, relu d'un bloc au moment d'annuler, et n'est jamais interrogé autrement. Deux
/// tables de plus n'apporteraient que des jointures.
///
/// ⚠️ Seul le dernier journal d'une édition peut être annulé, et une seule fois. Défaire un calcul
/// par-dessus un autre reviendrait à restaurer un état que le suivant a déjà modifié.
model VolunteerAutoAssignRun {
  id           String   @id @default(cuid())
  eventId      Int
  executedById Int
  executedAt   DateTime @default(now())
  /// `replace-all`, `keep-all` ou `keep-manual`.
  mode         String
  /// Les contraintes telles que l'organisateur les avait réglées, pour savoir ce qui a produit ce
  /// planning — la question que l'on se pose toujours en second.
  constraints  Json

  /// Ce que le calcul a effacé, tel que c'était : de quoi le recréer à l'identique.
  deletedAssignments Json
  /// Ce qu'il a créé : de quoi le retirer.
  createdAssignments Json
  /// Les rattachements d'équipe, sur le même principe.
  deletedTeamLinks   Json
  createdTeamLinks   Json

  createdCount Int
  deletedCount Int

  /**
   * L'état du planning tel que ce calcul l'a laissé.
   * L'annulation ne refusait que si un AUTRE calcul avait été appliqué depuis. Elle ne voyait pas
   * les affectations posées à la main entre-temps : les retirer aurait fait disparaître ce
   * travail, et recréer les anciennes pouvait entrer en conflit avec lui.
   * Même mécanique que l'empreinte qui protège l'application : on compare avant d'écrire.
   */
  empreinteApres String?

  /// Renseignés quand le calcul a été annulé. Un journal annulé ne l'est pas deux fois.
  undoneAt   DateTime?
  undoneById Int?

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  executedBy User  @relation("VolunteerAutoAssignRun_executedBy", fields: [executedById], references: [id], onDelete: Cascade)
  undoneBy   User? @relation("VolunteerAutoAssignRun_undoneBy", fields: [undoneById], references: [id], onDelete: SetNull)

  @@index([eventId, executedAt])
  @@index([executedById])
  @@index([undoneById])
}

/// Un plan calculé, en attente d'être appliqué.
///
/// L'aperçu et l'application étaient deux calculs distincts : le bouton « Appliquer » relisait la
/// base et relançait l'algorithme. Entre les deux clics, un créneau ajouté, une candidature
/// acceptée ou une affectation posée par un collègue suffisaient à ce que le plan écrit ne soit
/// pas celui que l'organisateur avait validé.
///
/// L'aperçu conserve donc son résultat ici, avec une EMPREINTE des données qui l'ont produit.
/// L'application le relit, vérifie que l'empreinte tient toujours, et écrit exactement ce qui a
/// été montré — ou refuse, en demandant un nouvel aperçu.
///
/// Les plans sont éphémères : `expiresAt` dit jusqu'à quand celui-ci vaut encore la peine d'être
/// proposé. Un plan vieux d'une heure décrit une édition qui a probablement changé.
model VolunteerAutoAssignPlan {
  id          String   @id @default(cuid())
  eventId     Int
  createdById Int
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  /// Ce qui a produit ce plan, et qu'on revérifiera avant de l'appliquer.
  fingerprint String
  mode        String
  constraints Json

  /// Le plan lui-même, et le périmètre qui borne ce qu'il a le droit d'effacer.
  assignments Json
  perimetre   Json
  /// Le résultat complet montré à l'organisateur — statistiques, non-assignés, diagnostic.
  ///
  /// Conservé pour que l'application n'ait pas à relancer l'algorithme : elle le relançait
  /// uniquement pour produire une réponse dont elle jetait ensuite le contenu, et ce calcul
  /// coûte plusieurs secondes sur une grosse édition.
  resultat    Json?

  /// Renseigné quand le plan a été appliqué : un plan ne s'applique pas deux fois.
  appliedAt DateTime?

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User  @relation("VolunteerAutoAssignPlan_createdBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([createdById])
  @@index([expiresAt])
}

model ApplicationTeamAssignment {
  applicationId Int
  teamId        String
  isLeader      Boolean                   @default(false)
  assignedAt    DateTime                  @default(now())
  /// D'où vient ce rattachement : d'un organisateur, ou d'un calcul d'assignation automatique.
  ///
  /// Sans cette colonne, « tout effacer et recalculer » emportait les équipes attribuées à la
  /// main — une décision que rien ne reconstruit, et dont le calcul se sert pourtant pour scorer
  /// (`assignedTeams`, bonus d'équipe, mode strict). Le pendant exact de `VolunteerAssignment.source`.
  ///
  /// Par défaut manuelle, pour la même raison qu'elle : l'origine des lignes déjà en base est
  /// perdue, et une relance ne doit pas les balayer par surprise.
  source        VolunteerAssignmentSource @default(MANUAL)

  application EditionVolunteerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  team        VolunteerTeam               @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([applicationId, teamId])
  @@index([teamId])
  @@index([isLeader])
  /// La relance efface les rattachements automatiques : cet index évite un balayage complet.
  @@index([source])
}

/// Rattachement d'un organisateur d'édition à une équipe de bénévoles.
///
/// Table distincte de `ApplicationTeamAssignment`, et non un champ ajouté à celle-ci : un
/// organisateur n'a pas de candidature, et la table des candidatures ne saurait donc pas le
/// porter. Séparer les deux évite d'inventer des candidatures fantômes pour des gens qui n'en
/// ont jamais déposé.
model OrganizerTeamAssignment {
  editionOrganizerId Int
  teamId             String
  /// Un organisateur peut piloter une équipe, au même titre qu'un bénévole responsable — et
  /// avec les mêmes droits, qui ne dépendent donc plus d'une candidature acceptée.
  isLeader           Boolean  @default(false)
  assignedAt         DateTime @default(now())

  editionOrganizer EditionOrganizer @relation(fields: [editionOrganizerId], references: [id], onDelete: Cascade)
  team             VolunteerTeam    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([editionOrganizerId, teamId])
  @@index([teamId])
  @@index([isLeader])
}

/// Affectation d'un organisateur d'édition à un créneau de bénévolat.
///
/// Table distincte de `VolunteerAssignment`, mais pas parce qu'un organisateur pèserait moins :
/// il occupe une place comme un bénévole, et `maxVolunteers` les compte ensemble. Ce qui le
/// distingue est ailleurs — il n'a ni candidature, ni échange de créneau, ni part dans
/// l'assignation automatique.
///
/// Sans `assignedById`, contrairement à `VolunteerAssignment` : cette traçabilité y sert aux
/// échanges et à distinguer les affectations automatiques, deux mécaniques dont les
/// organisateurs sont hors de portée.
model OrganizerSlotAssignment {
  editionOrganizerId Int
  timeSlotId         String
  assignedAt         DateTime  @default(now())
  /// Quand le rappel « dans 30 minutes » a été envoyé à cet organisateur — constat B5.
  ///
  /// ⚠️ PORTÉE PAR L'AFFECTATION, PAS PAR LE CRÉNEAU, exactement comme celle des bénévoles
  /// (`VolunteerAssignment.reminderSentAt`, #642). Quelqu'un posé à la dernière minute en
  /// remplacement arrive avec sa propre ligne vierge et reçoit son rappel ; une marque sur le
  /// créneau l'en priverait en silence. Décision à ne pas rouvrir.
  ///
  /// Sans cette colonne, l'organisateur recevrait le rappel QUATRE À CINQ FOIS : la tâche tourne
  /// chaque minute sur une fenêtre de 28 à 32 minutes, donc un même créneau y tombe à plusieurs
  /// passages consécutifs. C'est le défaut que #642 avait refermé pour les seuls bénévoles.
  reminderSentAt     DateTime?

  editionOrganizer EditionOrganizer  @relation(fields: [editionOrganizerId], references: [id], onDelete: Cascade)
  timeSlot         VolunteerTimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)

  @@id([editionOrganizerId, timeSlotId])
  @@index([timeSlotId])
}

model VolunteerComment {
  id        Int      @id @default(autoincrement())
  userId    Int
  eventId   Int
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

/// Où en est une demande d'échange.
///
/// Deux accords sont nécessaires avant d'y toucher : celui du bénévole visé, puis celui d'un
/// organisateur. Un planning se déséquilibre vite, et l'échange qui arrange deux personnes peut
/// dégarnir un poste que ni l'une ni l'autre ne voit.
enum VolunteerSwapStatus {
  /// En attente de la réponse du bénévole visé.
  PENDING_PEER
  /// Les deux bénévoles sont d'accord ; un organisateur doit trancher.
  PENDING_MANAGER
  ACCEPTED
  /// Refusée par le bénévole visé ou par l'organisateur.
  REFUSED
  /// Retirée par le demandeur.
  CANCELLED
  /// L'un des deux créneaux est passé : l'échange n'a plus d'objet.
  EXPIRED
}

/// Demande d'échange d'un créneau contre un autre, entre deux bénévoles.
///
/// Un pour un : le demandeur offre l'une de ses affectations et en convoite une autre. Prendre un
/// créneau libre ou abandonner le sien sans contrepartie ne passe pas par ici.
///
/// Les deux affectations sont référencées par leur identifiant, en `Cascade` : si l'une disparaît
/// — désaffectation manuelle, relance de l'assignation automatique — la demande s'efface avec
/// elle. C'est le comportement voulu : elle porterait sur un créneau que plus personne ne tient.
model VolunteerSwapRequest {
  id                    String              @id @default(cuid())
  eventId               Int
  requesterId           Int
  targetId              Int
  /// Affectation offerte par le demandeur.
  requesterAssignmentId String
  /// Affectation convoitée, tenue par la cible.
  targetAssignmentId    String
  status                VolunteerSwapStatus @default(PENDING_PEER)
  /// Quand la cible a répondu, quel que soit son sens.
  peerRespondedAt       DateTime?
  /// L'organisateur qui a tranché, et quand.
  decidedById           Int?
  decidedAt             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  event               Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requester           User                @relation("VolunteerSwap_requester", fields: [requesterId], references: [id], onDelete: Cascade)
  target              User                @relation("VolunteerSwap_target", fields: [targetId], references: [id], onDelete: Cascade)
  decidedBy           User?               @relation("VolunteerSwap_decidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  requesterAssignment VolunteerAssignment @relation("VolunteerSwap_requesterAssignment", fields: [requesterAssignmentId], references: [id], onDelete: Cascade)
  targetAssignment    VolunteerAssignment @relation("VolunteerSwap_targetAssignment", fields: [targetAssignmentId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@index([requesterId])
  @@index([targetId])
  @@index([requesterAssignmentId])
  @@index([targetAssignmentId])
  @@index([decidedById])
}

// =============================================================================
// Carte du site (layer `map`, partagé avec app1) — mêmes modèles, rattachés à l'événement.
// Les relations vers les modules pas encore portés (stock, spectacles…) arriveront avec eux.
// =============================================================================

model EditionZone {
  id          Int      @id @default(autoincrement())
  event       Event    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  editionId   Int
  name        String   @db.VarChar(100)
  description String?  @db.Text
  color       String   @db.VarChar(7) // Format #RRGGBB
  coordinates Json // GeoJSON polygon coordinates
  zoneTypes   Json     @default("[\"OTHER\"]") // JSON array of EditionZoneType values
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Provenance : objet de la carte externe dont cette zone est issue (cf. app1).
  externalMapObjectId   String?   @db.VarChar(64)
  externalMapImportedAt DateTime?

  markers           EditionMarker[]
  stockItems        StockItem[]
  stockReservations StockReservation[]
  showPerformances  ShowPerformance[]

  @@unique([editionId, externalMapObjectId])
  @@index([editionId])
}

model EditionMarker {
  id          Int      @id @default(autoincrement())
  event       Event    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  editionId   Int
  name        String   @db.VarChar(100)
  description String?  @db.Text
  latitude    Float
  longitude   Float
  markerTypes Json     @default("[\"OTHER\"]") // JSON array of EditionZoneType values
  color       String?  @db.VarChar(7) // null = couleur du type
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  externalMapObjectId   String?   @db.VarChar(64)
  externalMapImportedAt DateTime?

  // Rattachement facultatif à une zone (son entrée). `SetNull` : supprimer une salle ne doit pas
  // effacer ses entrées au passage (cf. app1).
  zone   EditionZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  zoneId Int?

  stockItems        StockItem[]
  stockReservations StockReservation[]
  showPerformances  ShowPerformance[]

  @@unique([editionId, externalMapObjectId])
  @@index([editionId])
  @@index([zoneId])
}

// =============================================================================
// Stock et prêts (layer `stock`, partagé avec app1) — mêmes modèles, rattachés à l'événement.
// =============================================================================
// Stock matériel : suivi du matériel d'une édition (groupes, objets,
// réservations sur des périodes).

enum StockReservationStatus {
  RESERVED // Réservé (par défaut à la création)
  PICKED_UP // Sorti / pris par le réserveur
  RETURNED // Rendu au stock
  CANCELLED // Annulée
}

model StockGroup {
  id                  Int      @id @default(autoincrement())
  editionId           Int
  name                String
  description         String?  @db.Text
  // Ce groupe gère-t-il les réservations ?
  //
  // Fermé par défaut : tout le matériel ne se réserve pas. Un groupe « consommables » ou
  // « décoration » n'a que faire d'un calendrier et de quantités disponibles par période, et leur
  // présence encombre l'écran d'une mécanique dont personne ne se sert.
  //
  // ⚠️ La MIGRATION passe tous les groupes EXISTANTS à `true`. Le défaut sert les groupes à venir ;
  // sans cet UPDATE, les éditions qui réservent aujourd'hui perdraient le système du jour au
  // lendemain — y compris pendant une convention.
  //
  // Décocher est refusé tant qu'il reste des réservations : voir `reservations-du-groupe.ts`.
  reservationsEnabled Boolean  @default(false)
  displayOrder        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  event Event       @relation(fields: [editionId], references: [id], onDelete: Cascade)
  items StockItem[]

  @@index([editionId])
  @@index([editionId, displayOrder])
}

model StockItem {
  id                  Int       @id @default(autoincrement())
  stockGroupId        Int
  name                String
  description         String?   @db.Text
  quantity            Int       @default(1) // Nombre d'exemplaires identiques
  notes               String?   @db.Text
  displayOrder        Int       @default(0)
  // Emprunt externe : matériel prêté par quelqu'un d'extérieur à la convention.
  // Si `isExternalLoan` est false, les 3 champs suivants sont ignorés.
  isExternalLoan      Boolean   @default(false)
  ownerContact        String?   @db.Text // Texte libre (ex: "Jean Dupont — 06 12 34 56 78")
  returnDueAt         DateTime? // Date prévue de retour au propriétaire
  // Un emprunt a deux bouts : aller le chercher, puis le rapporter. Sans `pickedUpAt`, rien ne
  // distinguait un emprunt convenu mais pas encore récupéré d'un emprunt déjà sur place.
  pickedUpAt          DateTime? // Date effective de récupération. null = pas encore récupéré
  returnedAt          DateTime? // Date effective du retour. null = pas encore rendu
  // Où récupérer le matériel et où le rendre, et qui s'en charge. Les deux lieux sont distincts :
  // on emprunte souvent chez quelqu'un et on rend ailleurs. Texte libre, car ces lieux sont
  // généralement hors du site, où la carte de l'édition n'a rien à dire.
  // Le responsable est un utilisateur quand il en est un ; le champ texte prend le relais pour
  // quelqu'un qui n'a pas de compte.
  pickupLocation      String?   @db.Text
  pickupResponsibleId Int?
  pickupContact       String?   @db.Text
  returnLocation      String?   @db.Text
  returnResponsibleId Int?
  returnContact       String?   @db.Text
  // Quantité constatée au rangement, en fin d'édition. L'écart avec `quantity` dit ce qui manque.
  // `null` = pas encore compté, ce qui n'est pas la même chose que zéro.
  finalQuantity       Int?
  // Emplacement de rangement par défaut : où ranger le matériel quand il
  // n'est pas réservé. Au moins l'un des trois doit être renseigné si l'on
  // veut afficher un emplacement (validé côté API, tous peuvent rester null).
  location            String? // Texte libre (ex: "Tente technique B")
  zoneId              Int? // Lien optionnel vers une zone de la carte
  markerId            Int? // Lien optionnel vers un marqueur de la carte
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  group         StockGroup              @relation(fields: [stockGroupId], references: [id], onDelete: Cascade)
  zone          EditionZone?            @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  marker        EditionMarker?          @relation(fields: [markerId], references: [id], onDelete: SetNull)
  reservations  StockReservation[]
  tags          StockTagAssignment[]
  shoppingLists StockShoppingListItem[]

  pickupResponsible User? @relation("StockPickupResponsible", fields: [pickupResponsibleId], references: [id], onDelete: SetNull)
  returnResponsible User? @relation("StockReturnResponsible", fields: [returnResponsibleId], references: [id], onDelete: SetNull)

  @@index([stockGroupId])
  @@index([stockGroupId, displayOrder])
  @@index([zoneId])
  @@index([markerId])
  @@index([pickupResponsibleId])
  @@index([returnResponsibleId])
}

model StockReservation {
  id               Int                    @id @default(autoincrement())
  stockItemId      Int
  userId           Int // Utilisateur qui a posé la réservation
  startsAt         DateTime
  endsAt           DateTime
  usage            String                 @db.Text // Pourquoi : "Spectacle de feu samedi 22h"
  quantityReserved Int                    @default(1)
  status           StockReservationStatus @default(RESERVED)
  // Emplacement d'utilisation : où le matériel doit être amené pendant la
  // réservation. Différent du rangement (StockItem.location). À la fin de la
  // réservation, le matériel retourne à son emplacement de rangement.
  // Au moins l'un des trois (location/zoneId/markerId) doit être renseigné
  // (validé côté API).
  location         String? // Texte libre (ex: "Scène principale, fond droit")
  zoneId           Int? // Lien optionnel vers une zone de la carte
  markerId         Int? // Lien optionnel vers un marqueur de la carte
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  stockItem StockItem      @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  zone      EditionZone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  marker    EditionMarker? @relation(fields: [markerId], references: [id], onDelete: SetNull)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stockItemId])
  @@index([userId])
  @@index([zoneId])
  @@index([markerId])
  @@index([stockItemId, startsAt, endsAt])
  @@index([status])
}

/**
 * Étiquette transversale posée sur du matériel.
 * Le groupe dit où l'objet est rangé — une seule place, une seule façon de classer. Le tag dit
 * autre chose : une enceinte rangée en « Sonorisation » peut être à la fois fragile, lourde et
 * prêtée, sans que rien de cela ne commande son rangement.
 * Rattaché à l'ÉDITION et non au groupe, contrairement à `TaskTag` : c'est la seule façon de
 * retrouver le même « fragile » d'un groupe à l'autre sans le recréer partout.
 */
model StockTag {
  id           Int      @id @default(autoincrement())
  editionId    Int
  name         String
  color        String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event       Event                @relation(fields: [editionId], references: [id], onDelete: Cascade)
  assignments StockTagAssignment[]

  @@unique([editionId, name])
  @@index([editionId])
  @@index([editionId, displayOrder])
}

// Liaison many-to-many entre StockItem et StockTag. Un objet porte 0..N tags.
model StockTagAssignment {
  id          Int      @id @default(autoincrement())
  stockItemId Int
  tagId       Int
  createdAt   DateTime @default(now())

  item StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  tag  StockTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([stockItemId, tagId])
  @@index([stockItemId])
  @@index([tagId])
}

/**
 * Une liste de courses : ce qu'il faut racheter après une édition.
 * Le recomptage de fin d'édition dit ce qui manque, mais ne dit pas quoi en faire. Racheter se
 * décide en plusieurs fois et pour plusieurs endroits — la quincaillerie, le magasin de jonglerie,
 * la commande en ligne —, d'où PLUSIEURS listes nommées par édition plutôt qu'un seul inventaire
 * des manques, qui ne se découpe pas.
 * Rattachée à l'ÉDITION, comme `StockTag` : le matériel l'est, et une liste qui traverserait les
 * éditions mélangerait des inventaires sans rapport.
 */
model StockShoppingList {
  id        Int      @id @default(autoincrement())
  editionId Int
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event                   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  items StockShoppingListItem[]

  @@index([editionId])
}

/**
 * Un article d'une liste de courses, qui pointe vers du matériel du stock.
 * ⚠️ Le lien est VIVANT, et c'est un choix : renommer l'objet met la liste à jour, et la quantité
 * à racheter suit l'écart courant du recomptage plutôt que d'être figée à l'ajout. Deux
 * conséquences assumées : supprimer l'objet du stock retire l'article des listes (cascade), et un
 * recomptage postérieur modifie une liste déjà imprimée.
 * Il n'y a donc pas de nom ni de quantité stockés ici : les dupliquer inviterait à les laisser
 * diverger de la fiche, et c'est précisément ce que le lien vivant refuse.
 * `purchased` est la seule chose que l'article porte en propre — ce qui distingue une liste de
 * courses d'un simple export : on coche au fur et à mesure, et la liste montre ce qui reste.
 */
model StockShoppingListItem {
  id          Int      @id @default(autoincrement())
  listId      Int
  stockItemId Int
  purchased   Boolean  @default(false)
  createdAt   DateTime @default(now())

  list StockShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  item StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  // Un même objet ne s'ajoute pas deux fois à la même liste : deux lignes identiques se cocheraient
  // séparément et feraient douter de ce qui reste à acheter.
  @@unique([listId, stockItemId])
  @@index([listId])
  @@index([stockItemId])
}

// =============================================================================
// Artistes et spectacles (layer `artists`, partagé avec app1) — lot 4 de docs/flowvent-modules.md.
// Sans l'appel à spectacles (lot 5) : ni candidatures, ni conversation de groupe.
// =============================================================================

enum ShowType {
  STANDARD // Spectacle d'un seul tenant : les artistes sont associés au spectacle
  CABARET // Suite de numéros : les artistes sont associés à un numéro
}

enum AccommodationType {
  TENT // Tente
  VEHICLE // Véhicule aménagé (van, camion, camping-car)
  HOSTED // Hébergé (en dur, chez quelqu'un)
  OTHER // Autre
}

model EditionArtist {
  id                      Int       @id @default(autoincrement())
  editionId               Int
  userId                  Int
  /// Arrivée et départ sur place, en INSTANTS.
  ///
  /// C'étaient des chaînes libres — la valeur brute d'un champ `datetime-local`, sans fuseau :
  /// impossible à trier, à comparer, ou à afficher à l'heure du lieu. La carte de l'artiste les
  /// affichait d'ailleurs telles quelles, « 2025-10-31T15:00 ».
  ///
  /// La migration qui les convertit ancre chaque valeur au fuseau de son édition, faute de quoi
  /// une heure saisie « 15 h sur place » serait relue comme 15 h UTC.
  arrivalDateTime         DateTime?
  departureDateTime       DateTime?
  qrCodeToken             String?   @unique
  entryValidated          Boolean   @default(false)
  entryValidatedAt        DateTime?
  entryValidatedBy        Int?
  // Montants en **centimes entiers**, dans la devise de l'édition. Les additionner en flottant
  // ferait apparaître des écarts d'arrondi invisibles ligne à ligne mais réels au total ; la
  // trésorerie les agrège avec ceux de la billetterie, déjà en centimes. Conversion depuis les
  // unités courantes dans `shared/utils/money.ts`, jamais par un `* 100` disséminé.
  payment                 Int?
  paymentPaid             Boolean   @default(false)
  reimbursementMax        Int?
  reimbursementActual     Int?
  reimbursementActualPaid Boolean   @default(false)
  consumablesMax          Int?
  consumablesActual       Int?
  consumablesActualPaid   Boolean   @default(false)

  /// Le justificatif du DÉFRAIEMENT : billet de train, facture d'essence, péage.
  ///
  /// ⚠️ Une URL écrite par le CLIENT, comme `imageUrl` en trésorerie : le serveur n'en garde que le
  /// nom de fichier et ne suit jamais le chemin reçu — voir `artist-receipt-files.ts`. Un `PUT`
  /// pourrait sinon y glisser `../../../../etc/passwd`.
  ///
  /// 📍 Images ET PDF : beaucoup de billets de train n'existent que sous cette forme, et il
  /// faudrait sinon en faire une capture d'écran.
  reimbursementReceiptUrl String?

  /// Le justificatif des CONSOMMABLES. Même contrat que celui du défraiement ci-dessus.
  consumablesReceiptUrl String?

  /// LA FACTURE DE L'ARTISTE. Même contrat de dépôt que les deux justificatifs ci-dessus.
  ///
  /// 📍 C'est l'ARTISTE qui fournit sa facture — il la remet à la convention, pas l'inverse.
  /// `invoiceRequested` dit qu'une facture lui est demandée, `invoiceProvided` qu'il l'a remise.
  /// Les libellés français disaient l'inverse (« L'artiste demande une facture », « Facture
  /// fournie à l'artiste ») : ils sont corrigés, aucune donnée n'ayant été saisie sous cette
  /// lecture.
  ///
  /// 📍 Déposer un fichier ici vaut remise : l'écriture passe `invoiceProvided` à vrai. La case
  /// reste cochable seule, pour une facture reçue par courriel ou sur papier — mais un fichier
  /// présent et la case décochée serait une contradiction que personne ne saurait trancher.
  invoiceUrl String?

  /// Les coordonnées bancaires pour virer le cachet et les défraiements.
  ///
  /// ⚠️ PORTÉES PAR L'ARTISTE DE CETTE ÉDITION, et non par son compte. C'est délibéré, et c'est
  /// une question de confidentialité avant d'être une question de modèle : sur le compte, l'IBAN
  /// confié aux organisateurs d'une édition serait lisible par ceux de toutes les autres, sans que
  /// la personne l'ait jamais accepté. Le prix est connu — un artiste invité deux fois le ressaisit
  /// — et il est moins élevé que celui d'une donnée bancaire qui circule.
  ///
  /// 📍 PREMIÈRES DONNÉES BANCAIRES DU DÉPÔT. Lisibles par qui gère les artistes de l'édition
  /// (`canManageArtistsById`), comme les montants et les justificatifs du même onglet.
  ///
  /// ⚠️ ET, DEPUIS LE 17/11/2026, par qui gère la TRÉSORERIE (`canManageTreasuryById`), pour le
  /// seul point d'API des versements à faire (`/treasury/payouts`). Décision explicite de
  /// l'utilisateur, et non un effet de bord : c'est le trésorier qui exécute les virements, lui
  /// refuser l'IBAN lui ferait voir un versement à faire sans pouvoir le faire.
  ///
  /// La garde reste étroite : ce point d'API est le seul de la trésorerie à rendre des IBAN, et
  /// la lecture générale (`/treasury`) n'en rend toujours aucun — elle alimente aussi des écrans
  /// de consultation. Tous les autres lecteurs de cette table emploient un `select` explicite.
  ///
  /// Stockées NORMALISÉES — majuscules, sans espaces — par `shared/utils/coordonnees-bancaires.ts`,
  /// de sorte que deux saisies du même compte se comparent.
  iban                    String?            @db.VarChar(34)
  bic                     String?            @db.VarChar(11)
  organizerNotes          String?            @db.Text
  accommodationAutonomous Boolean            @default(false)
  accommodationType       AccommodationType?
  accommodationTypeOther  String?            @db.Text
  accommodationProposal   String?            @db.Text
  invoiceRequested        Boolean            @default(false)
  invoiceProvided         Boolean            @default(false)
  feeRequested            Boolean            @default(false)
  feeProvided             Boolean            @default(false)
  pickupRequired          Boolean            @default(false)
  pickupLocation          String?
  pickupResponsibleId     Int?
  dropoffRequired         Boolean            @default(false)
  dropoffLocation         String?
  dropoffResponsibleId    Int?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryValidatedByUser User?                 @relation("ArtistEntryValidator", fields: [entryValidatedBy], references: [id], onDelete: SetNull)
  pickupResponsible    User?                 @relation("ArtistPickupResponsible", fields: [pickupResponsibleId], references: [id], onDelete: SetNull)
  dropoffResponsible   User?                 @relation("ArtistDropoffResponsible", fields: [dropoffResponsibleId], references: [id], onDelete: SetNull)
  shows                ShowArtist[]
  mealSelections       ArtistMealSelection[]
  handoutItems         ArtistHandoutItem[]
  event                Event                 @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, userId])
  @@index([editionId])
  @@index([userId])
  @@index([entryValidatedBy])
  @@index([pickupResponsibleId])
  @@index([dropoffResponsibleId])
  @@index([qrCodeToken])
}

model Show {
  id             Int      @id @default(autoincrement())
  editionId      Int
  title          String
  type           ShowType @default(STANDARD)
  // Compagnie ou nom de scène de l'artiste qui porte le spectacle. Propre aux spectacles
  // STANDARD : dans un cabaret, chaque numéro a ses propres artistes, il n'y a pas de
  // compagnie unique à afficher au niveau de la soirée.
  companyName    String?
  description    String?  @db.Text
  technicalNeeds String?  @db.Text // Besoins techniques du spectacle (interne, non exposé publiquement)
  // La durée appartient à l'œuvre, pas au passage : un spectacle joué deux fois dure aussi
  // longtemps les deux soirs. Le quand et le où vivent dans `performances`.
  duration       Int?
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  artists         ShowArtist[]
  acts            ShowAct[]
  handoutItems    ShowHandoutItem[]
  performances    ShowPerformance[]
  // Le groupe de messagerie dédié au spectacle, créé à la première utilisation
  event           Event                @relation(fields: [editionId], references: [id], onDelete: Cascade)
  applications    ShowApplication[]
  conversation    Conversation?
  ticketingQuotas EditionArtistQuota[]

  @@index([editionId])
}

model ShowPerformance {
  id            Int      @id @default(autoincrement())
  showId        Int
  startDateTime DateTime
  location      String?
  zoneId        Int?
  markerId      Int?
  /// Une représentation peut être annoncée pendant qu'une autre reste en préparation.
  isPublic      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  show   Show           @relation(fields: [showId], references: [id], onDelete: Cascade)
  zone   EditionZone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  marker EditionMarker? @relation(fields: [markerId], references: [id], onDelete: SetNull)

  @@index([showId])
  @@index([showId, startDateTime])
  @@index([startDateTime])
  @@index([zoneId])
  @@index([markerId])
}

model ShowAct {
  id             Int      @id @default(autoincrement())
  showId         Int
  title          String
  // Compagnie ou nom de scène des artistes du numéro. Le pendant de `Show.companyName`, qui ne
  // vaut que pour un spectacle STANDARD : dans un cabaret, chaque numéro a la sienne.
  //
  // Rempli à l'import d'une candidature, depuis son `artistName` — sans quoi ce nom, obligatoire
  // pour le candidat et affiché partout dans l'appel à spectacle, disparaissait au moment précis
  // où la candidature devenait un numéro.
  companyName    String?
  position       Int // Ordre de passage dans le déroulé du cabaret
  duration       Int? // En minutes
  description    String?  @db.Text
  technicalNeeds String?  @db.Text // Besoins techniques (espace, son, lumière)
  stageSetup     String?  @db.Text // Mise en place scène (état de la scène avant/après le numéro)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  show    Show         @relation(fields: [showId], references: [id], onDelete: Cascade)
  artists ShowArtist[]

  @@index([showId])
  @@index([showId, position])
}

model ShowArtist {
  id        Int      @id @default(autoincrement())
  showId    Int
  // Renseigné uniquement quand l'artiste participe via un numéro (spectacle CABARET).
  // showId reste rempli dans tous les cas : c'est lui qui répond à « à quels spectacles
  // cet artiste participe-t-il ? », question posée par la billetterie, l'espace artiste
  // et le tableau de gestion.
  actId     Int?
  artistId  Int
  createdAt DateTime @default(now())

  show   Show          @relation(fields: [showId], references: [id], onDelete: Cascade)
  act    ShowAct?      @relation(fields: [actId], references: [id], onDelete: Cascade)
  artist EditionArtist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  // Un artiste peut apparaître dans plusieurs numéros du même cabaret, d'où actId dans la clé.
  // Attention : MySQL considère deux NULL comme distincts, cette contrainte ne protège donc
  // pas les liens sans numéro (actId null). Leur unicité est assurée par le code appelant,
  // qui remplace l'ensemble des liens à chaque mise à jour d'un spectacle.
  @@unique([showId, actId, artistId])
  @@index([showId])
  @@index([actId])
  @@index([artistId])
}

model ArtistHandoutItem {
  id            Int      @id @default(autoincrement())
  artistId      Int
  handoutItemId Int
  /// Nombre d'exemplaires remis pour cette association (ex. 3 tickets boisson).
  quantity      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  artist      EditionArtist        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  handoutItem TicketingHandoutItem @relation(fields: [handoutItemId], references: [id], onDelete: Cascade)

  @@unique([artistId, handoutItemId])
  @@index([artistId])
  @@index([handoutItemId])
}

model ShowHandoutItem {
  id            Int      @id @default(autoincrement())
  showId        Int
  handoutItemId Int
  /// Nombre d'exemplaires remis pour cette association (ex. 3 tickets boisson).
  quantity      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  show        Show                 @relation(fields: [showId], references: [id], onDelete: Cascade)
  handoutItem TicketingHandoutItem @relation(fields: [handoutItemId], references: [id], onDelete: Cascade)

  @@unique([showId, handoutItemId])
  @@index([showId])
  @@index([handoutItemId])
}

model ShowPreset {
  id     Int    @id @default(autoincrement())
  userId Int
  name   String

  // Infos artiste
  artistName   String // Nom de scène
  artistBio    String? @db.Text
  portfolioUrl String?
  videoUrl     String?
  socialLinks  String? @db.Text

  // Infos spectacle
  showTitle                 String
  showDescription           String  @db.Text
  showDuration              Int
  showCategory              String?
  technicalNeeds            String? @db.Text
  stageSetup                String? @db.Text // Mise en place sur scène (avant le numéro et état de la scène après)
  additionalPerformersCount Int     @default(0)
  additionalPerformers      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model ArtistNotificationGroup {
  id             String   @id @default(cuid())
  editionId      Int
  /// Facultatif : voir son jumeau côté bénévoles. L'envoi survit à son auteur.
  senderId       Int?
  title          String
  message        String   @db.Text
  targetType     String // 'all' ou 'shows'
  selectedShows  Json? // Identifiants des spectacles visés si targetType = 'shows'
  recipientCount Int
  sentAt         DateTime @default(now())

  sender        User?                            @relation(fields: [senderId], references: [id], onDelete: SetNull)
  confirmations ArtistNotificationConfirmation[]
  event         Event                            @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId])
  @@index([senderId])
}

model ArtistNotificationConfirmation {
  id                        String    @id @default(cuid())
  artistNotificationGroupId String
  userId                    Int
  confirmedAt               DateTime?

  notificationGroup ArtistNotificationGroup @relation(fields: [artistNotificationGroupId], references: [id], onDelete: Cascade)
  /// Cascade, pour la même raison que son jumeau côté bénévoles : la ligne appartient au
  /// destinataire.
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([artistNotificationGroupId, userId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// Tables DORMANTES, portées avec les artistes parce que leurs requêtes les incluent : articles
// remis (billetterie, lot 6) et repas (lot 7). Vides tant que ces modules ne sont pas portés ;
// leurs écrans restent cachés (modules inactifs, aucun droit). Relations vers les modèles à venir
// ajoutées avec eux.
// -----------------------------------------------------------------------------

model TicketingHandoutItem {
  id         Int      @id @default(autoincrement())
  editionId  Int
  name       String
  /// Cumulable : l'article est remis autant de fois qu'il est associé au
  /// participant (ex. un artiste jouant dans deux spectacles). Par défaut il
  /// n'est remis qu'une seule fois, quel que soit le nombre d'associations.
  cumulative Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event                          Event                                 @relation(fields: [editionId], references: [id], onDelete: Cascade)
  tiers                          TicketingTierHandoutItem[]
  options                        TicketingOptionHandoutItem[]
  volunteerTicketingHandoutItems EditionVolunteerHandoutItem[]
  artistTicketingHandoutItems    EditionArtistHandoutItem[]
  organizerTicketingHandoutItems EditionOrganizerHandoutItem[]
  customFields                   TicketingTierCustomFieldHandoutItem[]
  shows                          ShowHandoutItem[]
  artists                        ArtistHandoutItem[]
  meals                          VolunteerMealHandoutItem[]

  /// Deux articles de même nom dans une édition sont indiscernables partout : dans les huit
  /// modales de sélection, et surtout au guichet, où la liste de remise affiche deux lignes
  /// identiques. L'agrégation se faisant par identifiant, la règle « non cumulable » ne les
  /// fusionne jamais — elle ne protège que d'un même article associé plusieurs fois.
  ///
  /// La colonne est en `utf8mb4_unicode_ci` : l'unicité est donc insensible à la casse et aux
  /// accents, ce qui est bien l'intention — « Bracelet » et « bracelet » ne se distinguent pas
  /// davantage à l'œil.
  @@unique([editionId, name])
  @@index([editionId])
}

enum VolunteerMealType {
  BREAKFAST
  LUNCH
  DINNER
}

model VolunteerMeal {
  id        Int               @id @default(autoincrement())
  editionId Int
  date      DateTime          @db.Date
  mealType  VolunteerMealType
  enabled   Boolean           @default(true)
  phases    Json              @default("[]")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  artistMealSelections    ArtistMealSelection[]
  event                   Event                      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  mealSelections          VolunteerMealSelection[]
  organizerMealSelections OrganizerMealSelection[]
  handoutItems            VolunteerMealHandoutItem[]
  tiers                   TicketingTierMeal[]
  options                 TicketingOptionMeal[]
  participantValidations  TicketingOrderItemMeal[]

  @@unique([editionId, date, mealType])
  @@index([editionId])
  @@index([date])
}

model ArtistMealSelection {
  id         Int       @id @default(autoincrement())
  artistId   Int
  mealId     Int
  accepted   Boolean   @default(true)
  afterShow  Boolean   @default(false)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  artist EditionArtist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  meal   VolunteerMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@unique([artistId, mealId])
  @@index([artistId])
  @@index([mealId])
}

// =============================================================================
// Appels à spectacles (layer `artists`) — lot 5 de docs/flowvent-modules.md. La relation vers
// l'événement garde le nom d'app1, `edition` : les requêtes des appels la parcourent.
// =============================================================================

enum ShowCallMode {
  INTERNAL // Formulaire interne sur la plateforme
  EXTERNAL // URL externe vers un autre formulaire
}

enum ShowCallVisibility {
  OFFLINE // Hors ligne, invisible partout (pages publiques, listes)
  CLOSED // Fermé, pas de candidature possible mais visible
  PRIVATE // Ouvert aux candidatures via lien direct uniquement
  PUBLIC // Ouvert et listé partout
}

enum ShowApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model EditionShowCall {
  id                Int                @id @default(autoincrement())
  editionId         Int
  name              String // Nom de l'appel (ex: "Scène ouverte", "Gala", "Spectacles longs")
  visibility        ShowCallVisibility @default(OFFLINE)
  mode              ShowCallMode       @default(INTERNAL)
  externalUrl       String?
  description       String?            @db.Text
  deadline          DateTime?
  // Champs demandés (configurables par l'organisateur)
  askPortfolioUrl   Boolean            @default(true)
  askVideoUrl       Boolean            @default(true)
  askTechnicalNeeds Boolean            @default(true)
  askStageSetup     Boolean            @default(false) // Demander la mise en place sur scène (avant le numéro et état de la scène après)
  askAccommodation  Boolean            @default(false)
  askDepartureCity  Boolean            @default(false) // Demander la ville de départ pour le défraiement
  askSocialLinks    Boolean            @default(false) // Demander les réseaux sociaux
  requirePhone      Boolean            @default(true) // Téléphone obligatoire dans le formulaire de candidature (contact + performers)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Date de la diffusion aux comptes artiste, à l'ouverture au public. Renseignée une seule fois :
  // c'est elle qui empêche de rediffuser à chaque bascule en PUBLIC.
  openedNotifiedAt DateTime?

  // Sondage
  surveyToken String? @unique
  surveyOpen  Boolean @default(false)

  edition      Event                @relation(fields: [editionId], references: [id], onDelete: Cascade)
  applications ShowApplication[]
  surveyVotes  ShowCallSurveyVote[]

  @@unique([editionId, name])
  @@index([editionId])
}

model ShowApplication {
  id         Int                   @id @default(autoincrement())
  showCallId Int
  userId     Int
  status     ShowApplicationStatus @default(PENDING)

  // Infos artiste
  artistName   String // Nom de scène
  artistBio    String? @db.Text // Présentation de l'artiste
  portfolioUrl String? // Site web / portfolio
  videoUrl     String? // Lien vidéo de démonstration
  socialLinks  String? @db.Text // Liens réseaux sociaux (un par ligne)

  // Infos spectacle proposé
  showTitle                 String // Titre du spectacle
  showDescription           String  @db.Text // Description détaillée
  showDuration              Int // Durée en minutes
  showCategory              String? // Type (jonglage, acrobatie, magie, etc.)
  technicalNeeds            String? @db.Text // Besoins techniques (espace, son, lumière)
  stageSetup                String? @db.Text // Mise en place sur scène (avant le numéro et état de la scène après)
  additionalPerformersCount Int     @default(0) // Nombre de personnes supplémentaires dans le spectacle
  additionalPerformers      Json? // Infos de contact des personnes supplémentaires [{lastName, firstName, email, phone}]

  // Logistique
  accommodationNeeded Boolean @default(false)
  accommodationNotes  String? @db.Text
  departureCity       String? // Ville de départ pour le défraiement

  // Gestion par les organisateurs
  organizerNotes String?   @db.Text // Notes internes organisateurs
  decidedAt      DateTime?
  decidedById    Int?

  // Lien vers un spectacle de l'édition (un même spectacle peut être lié à
  // plusieurs candidatures — cas d'un spectacle collectif où chaque artiste
  // postule séparément)
  showId Int?

  // Traçabilité
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  showCall     EditionShowCall      @relation(fields: [showCallId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy    User?                @relation("ShowApplicationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  show         Show?                @relation(fields: [showId], references: [id], onDelete: SetNull)
  conversation Conversation? // Conversation avec les organisateurs
  surveyVotes  ShowCallSurveyVote[]

  @@unique([showCallId, userId])
  @@index([showCallId])
  @@index([userId])
  @@index([status])
  @@index([showId])
}

model ShowCallSurveyVote {
  id            Int      @id @default(autoincrement())
  showCallId    Int
  applicationId Int
  userId        Int
  score         Int // 1 à 5
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  showCall    EditionShowCall @relation(fields: [showCallId], references: [id], onDelete: Cascade)
  application ShowApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([showCallId, applicationId, userId])
  @@index([showCallId])
  @@index([applicationId])
  @@index([userId])
}

// Conversation DORMANTE : Flowvent n'a pas de messagerie (décision de l'utilisateur), mais les
// requêtes des candidatures sélectionnent `conversation { id }` pour compter les non-lus. Réduite à
// ses liens, toujours vide : la sélection rend `null`, et les non-lus valent zéro.
model Conversation {
  id                String           @id @default(cuid())
  showApplicationId Int?             @unique
  showApplication   ShowApplication? @relation(fields: [showApplicationId], references: [id], onDelete: Cascade)
  showId            Int?             @unique
  show              Show?            @relation(fields: [showId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
}

// =============================================================================
// Billetterie (layer `ticketing`) — lot 6 de docs/flowvent-modules.md, HelloAsso seul dans
// l'interface. Avec les tables de liaison aux repas que ses requêtes lisent (DORMANTES jusqu'au
// lot 7), et le journal des erreurs serveur (ApiErrorLog) où elle signale ses échecs d'écriture.
// =============================================================================

enum ExternalTicketingProvider {
  HELLOASSO
  INFOMANIAK
  BILLETWEB
  WEEZEVENT
  OTHER
}

enum ExternalTicketingStatus {
  ACTIVE
  INACTIVE
  ERROR
}

model ExternalTicketing {
  id         String                    @id @default(cuid())
  editionId  Int                       @unique
  provider   ExternalTicketingProvider
  status     ExternalTicketingStatus   @default(ACTIVE)
  lastSyncAt DateTime?
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  event            Event                      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  helloAssoConfig  HelloAssoConfig?
  infomaniakConfig InfomaniakConfig?
  tiers            TicketingTier[]
  options          TicketingOption[]
  orders           TicketingOrder[]
  tierCustomFields TicketingTierCustomField[]

  @@index([editionId])
  @@index([provider])
  @@index([status])
}

model HelloAssoConfig {
  id                  String   @id @default(cuid())
  externalTicketingId String   @unique
  clientId            String
  clientSecret        String // Encrypted
  organizationSlug    String
  formType            String // Event, Membership, Donation, etc.
  formSlug            String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  externalTicketing ExternalTicketing @relation(fields: [externalTicketingId], references: [id], onDelete: Cascade)

  @@index([externalTicketingId])
}

model SumupConfig {
  id           Int      @id @default(autoincrement())
  editionId    Int      @unique
  // Encrypted (AES-256-GCM) — clé d'affiliation SumUp du marchand.
  // Type Text car la valeur chiffrée (iv:encrypted:authTag en base64) peut dépasser
  // la limite VARCHAR(191) par défaut de Prisma + MySQL utf8mb4.
  affiliateKey String   @db.Text
  appId        String // App ID déclaré sur le dashboard SumUp (ex: com.example.myapp)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event Event @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId])
}

model InfomaniakConfig {
  id                  String   @id @default(cuid())
  externalTicketingId String   @unique
  apiKey              String // Encrypted (AES-256-GCM) — clé API shop (événements, zones, tarifs)
  apiKeyGuichet       String? // Encrypted (AES-256-GCM) — clé API guichet (commandes, billets)
  applicationPassword String? // Encrypted (AES-256-GCM) — mot de passe applicatif (header Authorization)
  currency            String   @default("2") // 1 = CHF, 2 = EUR
  eventId             Int? // ID de l'événement sélectionné
  eventName           String? // Nom de l'événement (pour affichage)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  externalTicketing ExternalTicketing @relation(fields: [externalTicketingId], references: [id], onDelete: Cascade)

  @@index([externalTicketingId])
}

model TicketingTier {
  id                  Int       @id @default(autoincrement())
  externalTicketingId String? // Null si tarif manuel (non HelloAsso)
  helloAssoTierId     Int? // ID du tarif dans HelloAsso, null si tarif manuel
  editionId           Int // Toujours associé à une édition
  name                String
  customName          String? // Nom personnalisé (prioritaire sur name si défini)
  description         String?   @db.Text
  price               Int // Prix en centimes
  minAmount           Int? // Montant minimum (pour tarifs libres)
  maxAmount           Int? // Montant maximum (pour tarifs libres)
  isActive            Boolean   @default(true)
  position            Int       @default(0) // Pour l'ordre d'affichage
  countAsParticipant  Boolean   @default(true) // Si ce tarif compte comme participant dans les stats
  validFrom           DateTime? // Date de début de validité (optionnel)
  validUntil          DateTime? // Date de fin de validité (optionnel)
  /// Quand le porteur de ce tarif est PRÉSENT sur place — à ne pas confondre avec `validFrom` et
  /// `validUntil` juste au-dessus, qui disent quand le BILLET peut servir.
  ///
  /// La distinction se voit sur un pass week-end vendu jusqu'au dernier jour : sa validité court
  /// jusqu'à la fermeture, sa présence s'arrête au départ du festivalier. C'est cette seconde date
  /// qui fait redescendre la courbe d'affluence — sans elle, aucune sortie n'étant enregistrée, la
  /// courbe ne pouvait que monter.
  ///
  /// N'a de sens que si `countAsParticipant` : un tee-shirt ou un don n'amène personne.
  presenceFrom        DateTime?
  presenceUntil       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  externalTicketing ExternalTicketing?                    @relation(fields: [externalTicketingId], references: [id], onDelete: Cascade)
  event             Event                                 @relation(fields: [editionId], references: [id], onDelete: Cascade)
  quotas            TicketingTierQuota[]
  handoutItems      TicketingTierHandoutItem[]
  orderItems        TicketingOrderItem[]
  customFields      TicketingTierCustomFieldAssociation[]
  meals             TicketingTierMeal[]
  options           TicketingTierOption[]
  /// Rattachement éventuel à une ligne de trésorerie, qui tire alors son montant de ce tarif.
  treasuryEntries   TreasuryEntryTier[]

  @@unique([externalTicketingId, helloAssoTierId])
  @@index([externalTicketingId])
  @@index([editionId])
}

model TicketingQuota {
  id          Int      @id @default(autoincrement())
  editionId   Int
  title       String
  description String?  @db.Text
  quantity    Int // Nombre (toujours positif)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event        Event                           @relation(fields: [editionId], references: [id], onDelete: Cascade)
  tiers        TicketingTierQuota[]
  options      TicketingOptionQuota[]
  customFields TicketingTierCustomFieldQuota[]
  organizers   EditionOrganizerQuota[]
  volunteers   EditionVolunteerQuota[]
  artists      EditionArtistQuota[]

  @@index([editionId])
}

model EditionVolunteerHandoutItem {
  id            Int      @id @default(autoincrement())
  editionId     Int
  handoutItemId Int
  /// Nombre d'exemplaires remis pour cette association (ex. 3 tickets boisson).
  quantity      Int      @default(1)
  teamId        String? // NULL = global (tous les bénévoles), défini = équipe spécifique
  /// Les phases où cet article est remis : `SETUP`, `EVENT`, `TEARDOWN`.
  ///
  /// ⚠️ TABLEAU VIDE = TOUTES LES PHASES, et c'est ce qui rend la migration sans rattrapage :
  /// les associations existantes gardent exactement le comportement qu'elles avaient.
  ///
  /// ⚠️⚠️ MÊME FORME ET MÊME VOCABULAIRE QUE `VolunteerMeal.phases`, délibérément. Ces deux
  /// réglages répondent à la même question — « à quel moment de l'édition cela s'applique-t-il ? » —
  /// et les écrire différemment obligerait à traduire de l'un vers l'autre à chaque lecture, pour
  /// finir par diverger.
  phases        Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event       Event                @relation(fields: [editionId], references: [id], onDelete: Cascade)
  handoutItem TicketingHandoutItem @relation(fields: [handoutItemId], references: [id], onDelete: Cascade)
  team        VolunteerTeam?       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([editionId, handoutItemId, teamId])
  @@index([editionId])
  @@index([handoutItemId])
  @@index([teamId])
}

model EditionArtistHandoutItem {
  id            Int      @id @default(autoincrement())
  editionId     Int
  handoutItemId Int
  /// Nombre d'exemplaires remis pour cette association (ex. 3 tickets boisson).
  quantity      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event       Event                @relation(fields: [editionId], references: [id], onDelete: Cascade)
  handoutItem TicketingHandoutItem @relation(fields: [handoutItemId], references: [id], onDelete: Cascade)

  @@unique([editionId, handoutItemId])
  @@index([editionId])
  @@index([handoutItemId])
}

model EditionOrganizerHandoutItem {
  id            Int      @id @default(autoincrement())
  editionId     Int
  handoutItemId Int
  /// Nombre d'exemplaires remis pour cette association (ex. 3 tickets boisson).
  quantity      Int      @default(1)
  organizerId   Int? // NULL = global (tous les organisateurs), défini = organisateur spécifique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event       Event                @relation(fields: [editionId], references: [id], onDelete: Cascade)
  organizer   EditionOrganizer?    @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  handoutItem TicketingHandoutItem @relation(fields: [handoutItemId], references: [id], onDelete: Cascade)

  @@unique([editionId, handoutItemId, organizerId])
  @@index([editionId])
  @@index([handoutItemId])
  @@index([organizerId])
}

model EditionOrganizerQuota {
  id          Int      @id @default(autoincrement())
  editionId   Int
  quotaId     Int
  organizerId Int? // NULL = tous les organisateurs de l'édition
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event     Event             @relation(fields: [editionId], references: [id], onDelete: Cascade)
  quota     TicketingQuota    @relation(fields: [quotaId], references: [id], onDelete: Cascade)
  organizer EditionOrganizer? @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@unique([editionId, quotaId, organizerId])
  @@index([editionId])
  @@index([quotaId])
  @@index([organizerId])
}

model EditionVolunteerQuota {
  id        Int      @id @default(autoincrement())
  editionId Int
  quotaId   Int
  teamId    String? // NULL = tous les bénévoles acceptés
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event          @relation(fields: [editionId], references: [id], onDelete: Cascade)
  quota TicketingQuota @relation(fields: [quotaId], references: [id], onDelete: Cascade)
  team  VolunteerTeam? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([editionId, quotaId, teamId])
  @@index([editionId])
  @@index([quotaId])
  @@index([teamId])
}

model EditionArtistQuota {
  id        Int      @id @default(autoincrement())
  editionId Int
  quotaId   Int
  showId    Int? // NULL = tous les artistes de l'édition
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event          @relation(fields: [editionId], references: [id], onDelete: Cascade)
  quota TicketingQuota @relation(fields: [quotaId], references: [id], onDelete: Cascade)
  show  Show?          @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([editionId, quotaId, showId])
  @@index([editionId])
  @@index([quotaId])
  @@index([showId])
}

model TicketingTierQuota {
  id      Int @id @default(autoincrement())
  tierId  Int
  quotaId Int

  tier  TicketingTier  @relation(fields: [tierId], references: [id], onDelete: Cascade)
  quota TicketingQuota @relation(fields: [quotaId], references: [id], onDelete: Cascade)

  @@unique([tierId, quotaId])
  @@index([tierId])
  @@index([quotaId])
}

model TicketingTierHandoutItem {
  id            Int @id @default(autoincrement())
  tierId        Int
  handoutItemId Int

  /// Nombre d'exemplaires remis pour cette association (ex. 3 tickets boisson).
  quantity    Int                  @default(1)
  tier        TicketingTier        @relation(fields: [tierId], references: [id], onDelete: Cascade)
  handoutItem TicketingHandoutItem @relation(fields: [handoutItemId], references: [id], onDelete: Cascade)

  @@unique([tierId, handoutItemId])
  @@index([tierId])
  @@index([handoutItemId])
}

model TicketingTierOption {
  id       Int @id @default(autoincrement())
  tierId   Int
  optionId Int

  tier   TicketingTier   @relation(fields: [tierId], references: [id], onDelete: Cascade)
  option TicketingOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([tierId, optionId])
  @@index([tierId])
  @@index([optionId])
}

model TicketingOptionQuota {
  id       Int @id @default(autoincrement())
  optionId Int
  quotaId  Int

  option TicketingOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  quota  TicketingQuota  @relation(fields: [quotaId], references: [id], onDelete: Cascade)

  @@unique([optionId, quotaId])
  @@index([optionId])
  @@index([quotaId])
}

model TicketingOptionHandoutItem {
  id            Int @id @default(autoincrement())
  optionId      Int
  handoutItemId Int

  /// Nombre d'exemplaires remis pour cette association (ex. 3 tickets boisson).
  quantity    Int                  @default(1)
  option      TicketingOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  handoutItem TicketingHandoutItem @relation(fields: [handoutItemId], references: [id], onDelete: Cascade)

  @@unique([optionId, handoutItemId])
  @@index([optionId])
  @@index([handoutItemId])
}

model TicketingOption {
  id                  Int      @id @default(autoincrement())
  /// ⚠️ Renseigné même pour une option créée À LA MAIN : `createOption` exige une configuration
  /// de billetterie externe et y rattache l'option. Ce champ ne dit donc PAS d'où vient l'option
  /// — contrairement au tarif, dont l'équivalent reste bien nul quand il est manuel.
  externalTicketingId String?
  /// ID de l'option chez HelloAsso, nul si l'option a été saisie ici. C'est LUI qui distingue une
  /// option importée d'une option manuelle.
  helloAssoOptionId   String?
  editionId           Int // Toujours associé à une édition
  name                String
  description         String?  @db.Text
  type                String // TextInput, CheckBox, Select, etc.
  isRequired          Boolean  @default(false)
  choices             Json? // Array de choix pour les Select/MultipleChoice
  price               Int? // Prix de l'option en centimes (null si pas de prix)
  position            Int      @default(0) // Pour l'ordre d'affichage
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  externalTicketing   ExternalTicketing?           @relation(fields: [externalTicketingId], references: [id], onDelete: Cascade)
  event               Event                        @relation(fields: [editionId], references: [id], onDelete: Cascade)
  quotas              TicketingOptionQuota[]
  handoutItems        TicketingOptionHandoutItem[]
  orderItemSelections TicketingOrderItemOption[]
  tiers               TicketingTierOption[]
  meals               TicketingOptionMeal[]

  @@unique([externalTicketingId, helloAssoOptionId])
  @@index([externalTicketingId])
  @@index([editionId])
}

model TicketingOrder {
  id                  Int     @id @default(autoincrement())
  externalTicketingId String? // Nullable pour les commandes manuelles
  helloAssoOrderId    Int? // Nullable pour les commandes manuelles
  editionId           Int // Lien direct vers l'édition

  // Informations du payeur
  payerFirstName String
  payerLastName  String
  payerEmail     String

  // Montant et statut
  amount        Int // Montant total en centimes
  status        String // Processed, Refunded, etc.
  paymentMethod String? // Type de paiement : cash, card, check, null si non payé
  checkNumber   String? // Numéro du chèque si paymentMethod = 'check'

  // Date de la commande
  orderDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event             Event                @relation(fields: [editionId], references: [id], onDelete: Cascade)
  externalTicketing ExternalTicketing?   @relation(fields: [externalTicketingId], references: [id], onDelete: Cascade)
  items             TicketingOrderItem[]

  @@unique([externalTicketingId, helloAssoOrderId])
  @@index([externalTicketingId])
  @@index([editionId])
  @@index([payerEmail])
}

model TicketingOrderItem {
  id              Int  @id @default(autoincrement())
  orderId         Int // Lien vers TicketingOrder
  helloAssoItemId Int? // Nullable pour les participants ajoutés manuellement
  tierId          Int? // Lien vers le tarif HelloAsso

  // Informations du participant (peut différer du payeur)
  firstName String?
  lastName  String?
  email     String?

  // Détails du billet
  name   String? // Nom du tarif
  type   String? // Type d'item HelloAsso (Donation, Payment, Membership, etc.)
  amount Int // Prix payé en centimes
  state  String // Processed, Refunded, etc.
  qrCode String? // Code QR pour le contrôle d'accès

  // Champs personnalisés (réponses aux custom fields)
  customFields Json?

  // Validation d'entrée
  entryValidated   Boolean   @default(false)
  entryValidatedAt DateTime?
  entryValidatedBy Int?

  /// Quand ce billet a été annulé ici, et par qui.
  ///
  /// Le FAIT de l'annulation vit dans `state` (`Canceled`), lu par la porte, les statistiques, les
  /// repas et la trésorerie. Ces deux colonnes n'ajoutent que la trace — comme `entryValidatedAt`
  /// et `entryValidatedBy` juste au-dessus le font pour l'entrée.
  ///
  /// `null` sur une ligne `Canceled` signifie donc « annulée ailleurs qu'ici » : les 12 lignes
  /// annulées de la production viennent de HelloAsso.
  canceledAt   DateTime?
  canceledById Int?

  /// La REMISE accordée après coup sur ce billet, en centimes.
  ///
  /// ⚠️ À NE PAS CONFONDRE AVEC `refunded` JUSTE EN DESSOUS, qui est autre chose. Celui-là
  /// concerne un billet ANNULÉ : il dit si l'on a rendu l'argent d'une entrée à laquelle la
  /// personne n'a plus droit. Ici le billet reste VIVANT — droit d'entrée, repas, articles à
  /// remettre, quotas, tout est inchangé — et l'on rend seulement une partie du prix : un geste
  /// commercial, une erreur de tarif, un dédommagement.
  ///
  /// ⚠️ ET CELLE-CI PÈSE SUR LA TRÉSORERIE, contrairement à `refunded`. Ce dernier n'a aucun effet
  /// parce que l'annulation a déjà retiré la totalité du montant avant lui. Rien n'a été retiré
  /// d'un billet vivant : si la remise n'était pas soustraite de l'encaissé, celui-ci resterait au
  /// prix plein et se tromperait du montant rendu — sans erreur, sans alerte, et le compte ne
  /// tomberait qu'au bilan.
  ///
  /// `0` est l'absence de remise, pas une remise de zéro : les deux se valent ici, et un entier
  /// évite d'avoir à distinguer `null` de `0` dans chaque somme.
  ///
  /// 📍 Le système ENREGISTRE, il ne rembourse pas. HelloAsso ne sait pas rembourser partiellement
  /// — c'est déjà noté plus bas pour `sourceCanceledAt` — donc le mouvement d'argent se fait à la
  /// main, et ces colonnes en gardent la trace.
  discountAmount Int       @default(0)
  discountedAt   DateTime?
  discountedById Int?

  /// La remise a-t-elle été RENDUE à la personne, et quand, et par qui ?
  ///
  /// ⚠️ ACCORDER N'EST PAS RENDRE, exactement comme annuler n'est pas rembourser. Sur une commande
  /// déjà réglée, une remise accordée reste de l'argent qu'on doit tant que les espèces ne sont pas
  /// sorties. Le guichet affiche cette somme et coche cette case devant la personne.
  ///
  /// ⚠️ UNE CASE DISTINCTE DE `refunded`, et c'est un choix. Les deux pourraient paraître
  /// interchangeables — les deux disent « l'argent est sorti » — mais ils ne portent pas sur la
  /// même somme : `refunded` solde le prix ENTIER d'un billet annulé, celle-ci solde la seule
  /// remise d'un billet vivant. Un billet remisé puis annulé doit son prix entier MOINS la remise
  /// déjà rendue ; avec une case unique, rien ne dirait laquelle des deux sommes est sortie, et
  /// l'on rendrait deux fois.
  ///
  /// 📍 Sans objet sur une commande en attente de paiement : la remise y réduit ce qui reste à
  /// payer, aucun argent ne bouge. `montantARembourser` l'écarte déjà par `commandeReglee`.
  discountPaidBack     Boolean   @default(false)
  discountPaidBackAt   DateTime?
  discountPaidBackById Int?

  /// A-t-on rendu l'argent à la personne, et quand, et qui l'a rendu ?
  ///
  /// **Annulé ne veut pas dire remboursé**, et c'est toute la raison d'être de ces colonnes : un
  /// billet réglé puis annulé reste de l'argent qu'on doit tant que cette case n'est pas cochée.
  /// Le guichet s'en sert pour afficher la somme due à qui présente son billet.
  ///
  /// Un oui/non et non un montant : le choix est assumé, un remboursement partiel — frais retenus
  /// — n'est pas exprimable ici.
  ///
  /// ⚠️ Sans effet sur la trésorerie, volontairement. Le montant quitte l'encaissé dès
  /// l'annulation, remboursé ou non ; ces colonnes ne servent qu'à savoir à qui l'on doit encore.
  refunded     Boolean   @default(false)
  refundedAt   DateTime?
  refundedById Int?

  /// Quand la billetterie externe a, à son tour, annoncé ce billet annulé.
  ///
  /// Sert à une seule chose, mais elle compte : repérer un **double remboursement**. On annule ici,
  /// on rend l'argent à la main — HelloAsso ne sachant pas rembourser partiellement — puis
  /// quelqu'un rembourse AUSSI chez le fournisseur. La personne a été payée deux fois, et rien ne
  /// le disait.
  ///
  /// L'alerte se déduit de deux colonnes : `refundedById` renseigné (quelqu'un d'ici a coché la
  /// case) ET `sourceCanceledAt` renseigné. Le rattrapage du 28/09 a délibérément laissé
  /// `refundedById` nul sur les lignes annulées par HelloAsso : sans quoi elles déclencheraient
  /// toutes une fausse alerte.
  ///
  /// Posée par la synchronisation, jamais par un geste d'ici.
  sourceCanceledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order           TicketingOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tier            TicketingTier?             @relation(fields: [tierId], references: [id])
  mealAccess      TicketingOrderItemMeal[]
  selectedOptions TicketingOrderItemOption[]

  @@index([orderId])
  @@index([tierId])
  @@index([helloAssoItemId])
  @@index([email])
  @@index([qrCode])
  @@index([entryValidated])
}

