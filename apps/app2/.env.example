# Base de données MySQL (Flowvent).
# Hors Docker : viser localhost:3307 (port publié par docker-compose.dev.yml).
# En Docker, docker-compose surcharge DATABASE_URL vers le service flowvent-db.
DATABASE_URL="mysql://flowvent_user:flowvent_password@localhost:3307/flowvent_db"

# Shadow DB (RAM) pour `prisma migrate dev` — accélère la création de migrations.
# En Docker (flux recommandé : `exec flowvent-app npx prisma migrate dev`), docker-compose fournit
# déjà SHADOW_DATABASE_URL vers le service flowvent-shadow-db. Décommenter uniquement pour un
# `migrate dev` lancé HORS Docker (port 3309 publié par docker-compose.dev.yml) :
# SHADOW_DATABASE_URL="mysql://root:rootpassword@localhost:3309/flowvent_shadow"

# Identifiants MySQL (utilisés par docker-compose pour créer/servir la base)
MYSQL_ROOT_PASSWORD="rootpassword"
MYSQL_DATABASE="flowvent_db"
MYSQL_USER="flowvent_user"
MYSQL_PASSWORD="flowvent_password"

# Secret de session nuxt-auth-utils (minimum 32 caractères).
# Générer : openssl rand -base64 32
NUXT_SESSION_PASSWORD="change-me-please-with-a-32-chars-minimum-secret"

# --- OAuth Google / Facebook (boutons « Continuer avec … ») ---
# Sans identifiants, le bouton reste affiché et renvoie sur /login.
# URL de retour à déclarer chez le fournisseur, EXACTEMENT :
#   Google (console.cloud.google.com → Identifiants → client OAuth → URI de redirection autorisés)
#   Meta   (developers.facebook.com → app → Facebook Login → URI de redirection OAuth valides)
NUXT_OAUTH_GOOGLE_CLIENT_ID=""
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=""
NUXT_OAUTH_GOOGLE_REDIRECT_URL="https://dev.flowvent.org/auth/google"
NUXT_OAUTH_FACEBOOK_CLIENT_ID=""
NUXT_OAUTH_FACEBOOK_CLIENT_SECRET=""
NUXT_OAUTH_FACEBOOK_REDIRECT_URL="https://dev.flowvent.org/auth/facebook"

# URL publique du site : liens des courriels ET hôte autorisé par le serveur de dev (allowedHosts).
# Le domaine ne vit que là, comme dans app1. Dev : https://dev.flowvent.org (ou http://localhost:3001).
NUXT_PUBLIC_SITE_URL="https://dev.flowvent.org"

# --- Déploiement (skill /deploy-flowvent) ---
# Webhooks Portainer des stacks flowvent-release et flowvent-prod (édition de la stack → « Webhook »).
# Secrets : ne jamais les afficher ni les commiter.
PORTAINER_RELEASE_WEBHOOK_URL=""
PORTAINER_PROD_WEBHOOK_URL=""
