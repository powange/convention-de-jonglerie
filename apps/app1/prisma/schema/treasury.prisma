// =============================================================================
// Trésorerie d'une édition
// =============================================================================
//
// Charges et produits d'une édition, en une vue.
//
// Les lignes provenant des artistes et de la billetterie ne sont **pas** recopiées ici : elles
// sont calculées à la lecture depuis leur source. Un montant corrigé se répercute donc
// immédiatement, là où une copie exigerait une resynchronisation et finirait par diverger en
// silence. Seuls le code d'imputation choisi pour chaque source et les lignes saisies à la main
// sont stockés.
//
// Tous les montants sont en centimes entiers, dans la devise de l'édition.

enum TreasuryEntryKind {
  EXPENSE // charge
  INCOME // produit
}

/// Origine d'une ligne calculée, pour lui rattacher un code d'imputation.
enum TreasurySource {
  ARTIST_PAYMENT // cachets des artistes
  ARTIST_REIMBURSEMENT // défraiements trajet
  ARTIST_CONSUMABLES // consommables
  TICKETING_PARTICIPANTS // billets comptés comme participants, remboursements déduits
  TICKETING_DONATIONS // dons, sans contrepartie
  TICKETING_OTHER // ventes annexes et tarifs non comptés comme participants
}

/// Code d'imputation comptable, défini au niveau de la convention.
///
/// Rattaché à la convention et non à l'édition : un plan comptable se réutilise d'une année sur
/// l'autre. Volontairement libre — code et libellé — pour ne présumer d'aucune réglementation
/// nationale, tout en évitant la saisie ligne à ligne qui produirait « 6257 » et « 6 257 » côte
/// à côte, sans regroupement fiable possible.
model TreasuryCode {
  id           Int      @id @default(autoincrement())
  conventionId Int
  code         String   @db.VarChar(32)
  label        String   @db.VarChar(120)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  convention  Convention           @relation(fields: [conventionId], references: [id], onDelete: Cascade)
  entries     TreasuryEntry[]
  sourceCodes TreasurySourceCode[]

  @@unique([conventionId, code])
  @@index([conventionId])
}

/// Ligne saisie à la main, en charge ou en produit.
/// Les tarifs de billetterie dont une ligne de trésorerie tire son montant.
///
/// ⚠️ CE N'EST PAS UNE SOUSTRACTION, C'EST UN RÉACHEMINEMENT. Une ligne de commande dont le tarif
/// est rattaché ici part vers ce produit nommé AU LIEU d'aller dans « Billetterie — entrées » ou
/// « Billetterie — autres produits ». Rien n'est retranché après coup, donc aucun écart au centime
/// n'est possible et le total de l'édition ne bouge pas : seule sa ventilation s'affine.
///
/// ⚠️ `@@unique([tierId])` : un tarif n'appartient qu'à UNE SEULE ligne. Sans cette contrainte,
/// son montant serait compté deux fois — et une règle seulement vérifiée par le code finit
/// toujours par être contournée par un autre chemin d'écriture.
///
/// `onDelete: Cascade` des deux côtés : supprimer la ligne défait les liens, et un tarif supprimé
/// sort simplement du calcul sans laisser de lien orphelin.
model TreasuryEntryTier {
  entryId Int
  tierId  Int
  entry   TreasuryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tier    TicketingTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@id([entryId, tierId])
  @@unique([tierId])
  @@index([entryId], map: "TreasuryEntryTier_entryId_fkey")
}

model TreasuryEntry {
  id             Int               @id @default(autoincrement())
  editionId      Int
  kind           TreasuryEntryKind
  title          String            @db.VarChar(150)
  description    String?           @db.Text
  /// Montant en centimes, toujours positif : c'est `kind` qui porte le sens.
  amount         Int
  codeId         Int?
  /// Justificatif : photo d'un ticket de caisse ou d'une facture, saisie depuis le téléphone.
  /// Chemin public sous `/uploads/`, comme les autres images envoyées par les organisateurs.
  imageUrl       String?
  /// Montant attendu et non encore réglé. Bascule la ligne de « réglé » vers « engagé » : le
  /// solde ne change pas, mais le réglé cesse de compter ce qui n'a pas été payé.
  isForecast     Boolean           @default(false)
  /// Dépense avancée de sa poche par quelqu'un — l'association lui doit ce montant.
  /// Sans objet sur une recette, où le serveur le force à `null`.
  advancedById   Int?
  /// La même avance, quand la personne n'a PAS de compte : son nom, saisi librement.
  ///
  /// Exclusif de `advancedById` — le serveur efface l'un dès que l'autre est posé. Beaucoup de
  /// ceux qui avancent de l'argent sur une convention ne sont pas inscrits sur le site : sans ce
  /// champ, on ne pouvait pas dire à qui l'association devait ce montant.
  advancedByName String?           @db.VarChar(150)
  /// L'avance a-t-elle été remboursée à la personne ? Sans objet sans `advancedById`.
  reimbursed     Boolean           @default(false)
  /// Le jour où l'argent a bougé — celui du ticket de caisse, de la facture, du virement.
  ///
  /// À ne pas confondre avec `createdAt` juste en dessous, qui dit seulement quand la ligne a été
  /// tapée dans l'outil. Les deux étaient confondues, et la seconde faisait office de première :
  /// saisir le lundi les tickets du week-end datait tout du lundi.
  ///
  /// `@db.Date` et non un instant : une date d'opération est une date CIVILE. Le 12 juin reste le
  /// 12 juin qu'on le lise depuis Paris ou depuis Montréal, alors qu'un instant se RELIT dans le
  /// fuseau du lecteur et peut alors changer de jour. Le risque est donc à l'affichage, d'où le
  /// formatage en UTC côté écran. Même choix que `EditionMeal.date`, lu comme lui en UTC.
  ///
  /// `null` sur les entrées antérieures à ce champ : on ne leur invente pas de date, et un tri
  /// croissant les regroupe en tête.
  operationDate  DateTime?         @db.Date
  /// Les tarifs dont cette ligne tire son montant. Vide = montant saisi à la main.
  ///
  /// Quand elle en porte, `amount` ci-dessus n'est PAS lu : le montant est recalculé à chaque
  /// lecture depuis les commandes. On y laisse 0 plutôt qu'une valeur qui mentirait.
  tiers          TreasuryEntryTier[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  edition    Edition       @relation(fields: [editionId], references: [id], onDelete: Cascade)
  code       TreasuryCode? @relation(fields: [codeId], references: [id], onDelete: SetNull)
  /// `SetNull` et non `Cascade` : un compte supprimé ne doit pas emporter la ligne comptable.
  /// L'avance devient anonyme, la dépense reste.
  advancedBy User?         @relation("TreasuryAdvances", fields: [advancedById], references: [id], onDelete: SetNull)

  @@index([editionId])
  @@index([codeId])
  @@index([advancedById])
}

/// Code d'imputation choisi pour une origine calculée.
///
/// Un code par origine et non par artiste : un comptable impute l'ensemble des cachets sur un
/// même compte, pas chaque artiste séparément.
model TreasurySourceCode {
  id        Int            @id @default(autoincrement())
  editionId Int
  source    TreasurySource
  codeId    Int

  edition Edition      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  code    TreasuryCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@unique([editionId, source])
  @@index([codeId])
}
