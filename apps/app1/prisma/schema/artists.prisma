// =============================================================================
// Artistes — Profils, spectacles, appels à candidatures et candidatures
// =============================================================================

enum ShowCallMode {
  INTERNAL // Formulaire interne sur la plateforme
  EXTERNAL // URL externe vers un autre formulaire
}

enum ShowCallVisibility {
  OFFLINE // Hors ligne, invisible partout (pages publiques, listes)
  CLOSED // Fermé, pas de candidature possible mais visible
  PRIVATE // Ouvert aux candidatures via lien direct uniquement
  PUBLIC // Ouvert et listé partout
}

enum ShowApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ShowType {
  STANDARD // Spectacle d'un seul tenant : les artistes sont associés au spectacle
  CABARET // Suite de numéros : les artistes sont associés à un numéro
}

enum AccommodationType {
  TENT // Tente
  VEHICLE // Véhicule aménagé (van, camion, camping-car)
  HOSTED // Hébergé (en dur, chez quelqu'un)
  OTHER // Autre
}

model EditionArtist {
  id                      Int       @id @default(autoincrement())
  editionId               Int
  userId                  Int
  /// Arrivée et départ sur place, en INSTANTS.
  ///
  /// C'étaient des chaînes libres — la valeur brute d'un champ `datetime-local`, sans fuseau :
  /// impossible à trier, à comparer, ou à afficher à l'heure du lieu. La carte de l'artiste les
  /// affichait d'ailleurs telles quelles, « 2025-10-31T15:00 ».
  ///
  /// La migration qui les convertit ancre chaque valeur au fuseau de son édition, faute de quoi
  /// une heure saisie « 15 h sur place » serait relue comme 15 h UTC.
  arrivalDateTime         DateTime?
  departureDateTime       DateTime?
  qrCodeToken             String?   @unique
  entryValidated          Boolean   @default(false)
  entryValidatedAt        DateTime?
  entryValidatedBy        Int?
  // Montants en **centimes entiers**, dans la devise de l'édition. Les additionner en flottant
  // ferait apparaître des écarts d'arrondi invisibles ligne à ligne mais réels au total ; la
  // trésorerie les agrège avec ceux de la billetterie, déjà en centimes. Conversion depuis les
  // unités courantes dans `shared/utils/money.ts`, jamais par un `* 100` disséminé.
  payment                 Int?
  paymentPaid             Boolean   @default(false)
  reimbursementMax        Int?
  reimbursementActual     Int?
  reimbursementActualPaid Boolean   @default(false)
  consumablesMax          Int?
  consumablesActual       Int?
  consumablesActualPaid   Boolean   @default(false)

  /// Le justificatif du DÉFRAIEMENT : billet de train, facture d'essence, péage.
  ///
  /// ⚠️ Une URL écrite par le CLIENT, comme `imageUrl` en trésorerie : le serveur n'en garde que le
  /// nom de fichier et ne suit jamais le chemin reçu — voir `artist-receipt-files.ts`. Un `PUT`
  /// pourrait sinon y glisser `../../../../etc/passwd`.
  ///
  /// 📍 Images ET PDF : beaucoup de billets de train n'existent que sous cette forme, et il
  /// faudrait sinon en faire une capture d'écran.
  reimbursementReceiptUrl String?

  /// Le justificatif des CONSOMMABLES. Même contrat que celui du défraiement ci-dessus.
  consumablesReceiptUrl   String?

  /// LA FACTURE DE L'ARTISTE. Même contrat de dépôt que les deux justificatifs ci-dessus.
  ///
  /// 📍 C'est l'ARTISTE qui fournit sa facture — il la remet à la convention, pas l'inverse.
  /// `invoiceRequested` dit qu'une facture lui est demandée, `invoiceProvided` qu'il l'a remise.
  /// Les libellés français disaient l'inverse (« L'artiste demande une facture », « Facture
  /// fournie à l'artiste ») : ils sont corrigés, aucune donnée n'ayant été saisie sous cette
  /// lecture.
  ///
  /// 📍 Déposer un fichier ici vaut remise : l'écriture passe `invoiceProvided` à vrai. La case
  /// reste cochable seule, pour une facture reçue par courriel ou sur papier — mais un fichier
  /// présent et la case décochée serait une contradiction que personne ne saurait trancher.
  invoiceUrl              String?

  /// Les coordonnées bancaires pour virer le cachet et les défraiements.
  ///
  /// ⚠️ PORTÉES PAR L'ARTISTE DE CETTE ÉDITION, et non par son compte. C'est délibéré, et c'est
  /// une question de confidentialité avant d'être une question de modèle : sur le compte, l'IBAN
  /// confié aux organisateurs d'une édition serait lisible par ceux de toutes les autres, sans que
  /// la personne l'ait jamais accepté. Le prix est connu — un artiste invité deux fois le ressaisit
  /// — et il est moins élevé que celui d'une donnée bancaire qui circule.
  ///
  /// 📍 PREMIÈRES DONNÉES BANCAIRES DU DÉPÔT. Elles ne sont lisibles que par qui gère les artistes
  /// de l'édition (`canManageArtistsById`), comme les montants et les justificatifs du même
  /// onglet. Aucun autre point d'API ne les rend : tous les autres lecteurs de cette table
  /// emploient un `select` explicite, seule la liste de gestion est en `include`.
  ///
  /// Stockées NORMALISÉES — majuscules, sans espaces — par `shared/utils/coordonnees-bancaires.ts`,
  /// de sorte que deux saisies du même compte se comparent.
  iban                    String?            @db.VarChar(34)
  bic                     String?            @db.VarChar(11)
  organizerNotes          String?            @db.Text
  accommodationAutonomous Boolean            @default(false)
  accommodationType       AccommodationType?
  accommodationTypeOther  String?            @db.Text
  accommodationProposal   String?            @db.Text
  invoiceRequested        Boolean            @default(false)
  invoiceProvided         Boolean            @default(false)
  feeRequested            Boolean            @default(false)
  feeProvided             Boolean            @default(false)
  pickupRequired          Boolean            @default(false)
  pickupLocation          String?
  pickupResponsibleId     Int?
  dropoffRequired         Boolean            @default(false)
  dropoffLocation         String?
  dropoffResponsibleId    Int?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  edition              Edition               @relation(fields: [editionId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryValidatedByUser User?                 @relation("ArtistEntryValidator", fields: [entryValidatedBy], references: [id], onDelete: SetNull)
  pickupResponsible    User?                 @relation("ArtistPickupResponsible", fields: [pickupResponsibleId], references: [id], onDelete: SetNull)
  dropoffResponsible   User?                 @relation("ArtistDropoffResponsible", fields: [dropoffResponsibleId], references: [id], onDelete: SetNull)
  shows                ShowArtist[]
  mealSelections       ArtistMealSelection[]
  handoutItems         ArtistHandoutItem[]

  @@unique([editionId, userId])
  @@index([editionId])
  @@index([userId])
  @@index([entryValidatedBy])
  @@index([pickupResponsibleId])
  @@index([dropoffResponsibleId])
  @@index([qrCodeToken])
}

model Show {
  id             Int      @id @default(autoincrement())
  editionId      Int
  title          String
  type           ShowType @default(STANDARD)
  // Compagnie ou nom de scène de l'artiste qui porte le spectacle. Propre aux spectacles
  // STANDARD : dans un cabaret, chaque numéro a ses propres artistes, il n'y a pas de
  // compagnie unique à afficher au niveau de la soirée.
  companyName    String?
  description    String?  @db.Text
  technicalNeeds String?  @db.Text // Besoins techniques du spectacle (interne, non exposé publiquement)
  // La durée appartient à l'œuvre, pas au passage : un spectacle joué deux fois dure aussi
  // longtemps les deux soirs. Le quand et le où vivent dans `performances`.
  duration       Int?
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  edition         Edition              @relation(fields: [editionId], references: [id], onDelete: Cascade)
  artists         ShowArtist[]
  acts            ShowAct[]
  handoutItems    ShowHandoutItem[]
  ticketingQuotas EditionArtistQuota[]
  applications    ShowApplication[]
  performances    ShowPerformance[]
  // Le groupe de messagerie dédié au spectacle, créé à la première utilisation
  conversation    Conversation?

  @@index([editionId])
}

// Numéro d'un spectacle de type CABARET : une prestation courte au sein de la soirée.
// Les artistes d'un cabaret sont rattachés à un numéro, pas au spectacle.
/// Un passage d'un spectacle : une date, un lieu, et sa propre publication.
///
/// Un même spectacle est parfois joué plusieurs fois — deux soirs de suite, ou sur deux scènes
/// différentes. Avant, il fallait le saisir deux fois : titre, distribution et besoins
/// techniques dupliqués, et deux entrées au programme là où le public n'en voit qu'une, jouée
/// deux fois. Le spectacle reste l'œuvre ; ses représentations portent le quand et le où.
model ShowPerformance {
  id            Int      @id @default(autoincrement())
  showId        Int
  startDateTime DateTime
  location      String?
  zoneId        Int?
  markerId      Int?
  /// Une représentation peut être annoncée pendant qu'une autre reste en préparation.
  isPublic      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  show   Show           @relation(fields: [showId], references: [id], onDelete: Cascade)
  zone   EditionZone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  marker EditionMarker? @relation(fields: [markerId], references: [id], onDelete: SetNull)

  @@index([showId])
  @@index([showId, startDateTime])
  @@index([startDateTime])
  @@index([zoneId])
  @@index([markerId])
}

model ShowAct {
  id             Int      @id @default(autoincrement())
  showId         Int
  title          String
  // Compagnie ou nom de scène des artistes du numéro. Le pendant de `Show.companyName`, qui ne
  // vaut que pour un spectacle STANDARD : dans un cabaret, chaque numéro a la sienne.
  //
  // Rempli à l'import d'une candidature, depuis son `artistName` — sans quoi ce nom, obligatoire
  // pour le candidat et affiché partout dans l'appel à spectacle, disparaissait au moment précis
  // où la candidature devenait un numéro.
  companyName    String?
  position       Int // Ordre de passage dans le déroulé du cabaret
  duration       Int? // En minutes
  description    String?  @db.Text
  technicalNeeds String?  @db.Text // Besoins techniques (espace, son, lumière)
  stageSetup     String?  @db.Text // Mise en place scène (état de la scène avant/après le numéro)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  show    Show         @relation(fields: [showId], references: [id], onDelete: Cascade)
  artists ShowArtist[]

  @@index([showId])
  @@index([showId, position])
}

model ShowArtist {
  id        Int      @id @default(autoincrement())
  showId    Int
  // Renseigné uniquement quand l'artiste participe via un numéro (spectacle CABARET).
  // showId reste rempli dans tous les cas : c'est lui qui répond à « à quels spectacles
  // cet artiste participe-t-il ? », question posée par la billetterie, l'espace artiste
  // et le tableau de gestion.
  actId     Int?
  artistId  Int
  createdAt DateTime @default(now())

  show   Show          @relation(fields: [showId], references: [id], onDelete: Cascade)
  act    ShowAct?      @relation(fields: [actId], references: [id], onDelete: Cascade)
  artist EditionArtist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  // Un artiste peut apparaître dans plusieurs numéros du même cabaret, d'où actId dans la clé.
  // Attention : MySQL considère deux NULL comme distincts, cette contrainte ne protège donc
  // pas les liens sans numéro (actId null). Leur unicité est assurée par le code appelant,
  // qui remplace l'ensemble des liens à chaque mise à jour d'un spectacle.
  @@unique([showId, actId, artistId])
  @@index([showId])
  @@index([actId])
  @@index([artistId])
}

/// Articles à remettre à UN artiste précis, en complément de ceux remis à tous les artistes
/// (EditionArtistHandoutItem) et de ceux attachés à ses spectacles (ShowHandoutItem). Les trois
/// sources s'additionnent au moment de la remise : un article demandé pour un artiste donné ne
/// remplace pas ce que son spectacle lui vaut déjà.
model ArtistHandoutItem {
  id            Int      @id @default(autoincrement())
  artistId      Int
  handoutItemId Int
  /// Nombre d'exemplaires remis pour cette association (ex. 3 tickets boisson).
  quantity      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  artist      EditionArtist        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  handoutItem TicketingHandoutItem @relation(fields: [handoutItemId], references: [id], onDelete: Cascade)

  @@unique([artistId, handoutItemId])
  @@index([artistId])
  @@index([handoutItemId])
}

model ShowHandoutItem {
  id            Int      @id @default(autoincrement())
  showId        Int
  handoutItemId Int
  /// Nombre d'exemplaires remis pour cette association (ex. 3 tickets boisson).
  quantity      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  show        Show                 @relation(fields: [showId], references: [id], onDelete: Cascade)
  handoutItem TicketingHandoutItem @relation(fields: [handoutItemId], references: [id], onDelete: Cascade)

  @@unique([showId, handoutItemId])
  @@index([showId])
  @@index([handoutItemId])
}

// ========== APPEL À SPECTACLES ==========

// Configuration de l'appel à spectacles sur une édition
// Une édition peut avoir plusieurs appels (scène ouverte, gala, spectacles longs, etc.)
model EditionShowCall {
  id                Int                @id @default(autoincrement())
  editionId         Int
  name              String // Nom de l'appel (ex: "Scène ouverte", "Gala", "Spectacles longs")
  visibility        ShowCallVisibility @default(OFFLINE)
  mode              ShowCallMode       @default(INTERNAL)
  externalUrl       String?
  description       String?            @db.Text
  deadline          DateTime?
  // Champs demandés (configurables par l'organisateur)
  askPortfolioUrl   Boolean            @default(true)
  askVideoUrl       Boolean            @default(true)
  askTechnicalNeeds Boolean            @default(true)
  askStageSetup     Boolean            @default(false) // Demander la mise en place sur scène (avant le numéro et état de la scène après)
  askAccommodation  Boolean            @default(false)
  askDepartureCity  Boolean            @default(false) // Demander la ville de départ pour le défraiement
  askSocialLinks    Boolean            @default(false) // Demander les réseaux sociaux
  requirePhone      Boolean            @default(true) // Téléphone obligatoire dans le formulaire de candidature (contact + performers)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Date de la diffusion aux comptes artiste, à l'ouverture au public. Renseignée une seule fois :
  // c'est elle qui empêche de rediffuser à chaque bascule en PUBLIC.
  openedNotifiedAt DateTime?

  // Sondage
  surveyToken String? @unique
  surveyOpen  Boolean @default(false)

  edition      Edition              @relation(fields: [editionId], references: [id], onDelete: Cascade)
  applications ShowApplication[]
  surveyVotes  ShowCallSurveyVote[]

  @@unique([editionId, name])
  @@index([editionId])
}

// Preset de spectacle réutilisable pour les candidatures
model ShowPreset {
  id     Int    @id @default(autoincrement())
  userId Int
  name   String

  // Infos artiste
  artistName   String // Nom de scène
  artistBio    String? @db.Text
  portfolioUrl String?
  videoUrl     String?
  socialLinks  String? @db.Text

  // Infos spectacle
  showTitle                 String
  showDescription           String  @db.Text
  showDuration              Int
  showCategory              String?
  technicalNeeds            String? @db.Text
  stageSetup                String? @db.Text // Mise en place sur scène (avant le numéro et état de la scène après)
  additionalPerformersCount Int     @default(0)
  additionalPerformers      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

// Candidature d'un artiste avec sa proposition de spectacle
model ShowApplication {
  id         Int                   @id @default(autoincrement())
  showCallId Int
  userId     Int
  status     ShowApplicationStatus @default(PENDING)

  // Infos artiste
  artistName   String // Nom de scène
  artistBio    String? @db.Text // Présentation de l'artiste
  portfolioUrl String? // Site web / portfolio
  videoUrl     String? // Lien vidéo de démonstration
  socialLinks  String? @db.Text // Liens réseaux sociaux (un par ligne)

  // Infos spectacle proposé
  showTitle                 String // Titre du spectacle
  showDescription           String  @db.Text // Description détaillée
  showDuration              Int // Durée en minutes
  showCategory              String? // Type (jonglage, acrobatie, magie, etc.)
  technicalNeeds            String? @db.Text // Besoins techniques (espace, son, lumière)
  stageSetup                String? @db.Text // Mise en place sur scène (avant le numéro et état de la scène après)
  additionalPerformersCount Int     @default(0) // Nombre de personnes supplémentaires dans le spectacle
  additionalPerformers      Json? // Infos de contact des personnes supplémentaires [{lastName, firstName, email, phone}]

  // Logistique
  accommodationNeeded Boolean @default(false)
  accommodationNotes  String? @db.Text
  departureCity       String? // Ville de départ pour le défraiement

  // Gestion par les organisateurs
  organizerNotes String?   @db.Text // Notes internes organisateurs
  decidedAt      DateTime?
  decidedById    Int?

  // Lien vers un spectacle de l'édition (un même spectacle peut être lié à
  // plusieurs candidatures — cas d'un spectacle collectif où chaque artiste
  // postule séparément)
  showId Int?

  // Traçabilité
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  showCall     EditionShowCall      @relation(fields: [showCallId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy    User?                @relation("ShowApplicationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  show         Show?                @relation(fields: [showId], references: [id], onDelete: SetNull)
  conversation Conversation? // Conversation avec les organisateurs
  surveyVotes  ShowCallSurveyVote[]

  @@unique([showCallId, userId])
  @@index([showCallId])
  @@index([userId])
  @@index([status])
  @@index([showId])
}

// Vote dans un sondage de candidatures spectacles
model ShowCallSurveyVote {
  id            Int      @id @default(autoincrement())
  showCallId    Int
  applicationId Int
  userId        Int
  score         Int // 1 à 5
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  showCall    EditionShowCall @relation(fields: [showCallId], references: [id], onDelete: Cascade)
  application ShowApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([showCallId, applicationId, userId])
  @@index([showCallId])
  @@index([applicationId])
  @@index([userId])
}

// =============================================================================
// Notifications aux artistes
// =============================================================================

/// Un envoi groupé aux artistes d'une édition, conservé pour savoir ce qui a été annoncé.
/// Décalque de `VolunteerNotificationGroup`, le périmètre portant sur des spectacles
/// plutôt que sur des équipes.
model ArtistNotificationGroup {
  id             String   @id @default(cuid())
  editionId      Int
  /// Facultatif : voir son jumeau côté bénévoles. L'envoi survit à son auteur.
  senderId       Int?
  title          String
  message        String   @db.Text
  targetType     String // 'all' ou 'shows'
  selectedShows  Json? // Identifiants des spectacles visés si targetType = 'shows'
  recipientCount Int
  sentAt         DateTime @default(now())

  edition       Edition                          @relation(fields: [editionId], references: [id], onDelete: Cascade)
  sender        User?                            @relation(fields: [senderId], references: [id], onDelete: SetNull)
  confirmations ArtistNotificationConfirmation[]

  @@index([editionId])
  @@index([senderId])
}

/// Accusé de lecture d'un artiste pour un envoi donné. `confirmedAt` reste nul tant que
/// l'artiste n'a pas confirmé : la ligne existe dès l'envoi, ce qui permet de distinguer
/// « pas encore lu » de « jamais destinataire ».
model ArtistNotificationConfirmation {
  id                        String    @id @default(cuid())
  artistNotificationGroupId String
  userId                    Int
  confirmedAt               DateTime?

  notificationGroup ArtistNotificationGroup @relation(fields: [artistNotificationGroupId], references: [id], onDelete: Cascade)
  /// Cascade, pour la même raison que son jumeau côté bénévoles : la ligne appartient au
  /// destinataire.
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([artistNotificationGroupId, userId])
  @@index([userId])
}
