// Veille des conventions : les événements repérés dans les agendas de sites extérieurs
// (JugglingEdge en premier), en attente d'un jugement humain avant import.
//
// Le contrat d'une source vit dans `server/utils/sources-evenements.ts` ; la table ci-dessous ne
// range que ce qu'une source a dit et ce qu'un administrateur en a décidé.

model CandidatEvenement {
  id Int @id @default(autoincrement())

  // La clé de la source qui l'a vu (`SourceEvenements.cle`), p. ex. `jugglingedge`.
  source String @db.VarChar(40)

  // ⚠️ L'URL CANONIQUE, et la clé de tout le dispositif — d'où l'unicité.
  //
  // C'est elle que l'on compare aux éditions déjà importées, et c'est à elle que s'attache le
  // refus d'un administrateur. Une source qui désignerait le même événement sous deux URL ferait
  // réapparaître ce qu'on a écarté : les sources doivent donc rendre l'URL que le site donne
  // lui-même, jamais celle qu'on a suivie pour y arriver.
  url String @unique @db.VarChar(500)

  // Son identifiant chez la source, quand elle en expose un. Pour le journal, pas pour la clé.
  identifiantSource String? @db.VarChar(60)

  // Ce que la source a dit, sans normalisation : le pays est écrit comme elle l'écrit.
  titre   String    @db.VarChar(300)
  debut   DateTime?
  jours   Int? // Durée annoncée. Indice pour le tri, jamais un verdict.
  pays    String?   @db.VarChar(120)
  lieu    String?   @db.VarChar(300)
  adresse String?   @db.Text

  verdict   VerdictCandidat @default(A_EXAMINER)
  verdictLe DateTime?

  // ──────────────────────────────────────────────────────────────────────────────────────────
  // L'avis de la classification automatique — DANS SES PROPRES CHAMPS.
  //
  // ⚠️ Il ne touche JAMAIS `verdict`, et c'est l'invariant de tout le module. Écrire l'avis de
  // l'IA dans le verdict humain laisserait une relance automatique écraser une décision prise à
  // la main : un refus reviendrait au balayage suivant, soit exactement ce que la fonctionnalité
  // existe pour empêcher.
  //
  // 📍 L'avis TRIE, il ne MASQUE pas. Un candidat qu'elle juge hors sujet reste `A_EXAMINER` et
  // reste atteignable par un filtre dédié : une convention mal classée doit rester rattrapable,
  // sans quoi la classification ferait disparaître du travail en silence.
  avisIa   AvisIa?
  avisIaLe DateTime?

  // Ce que le modèle a répondu pour justifier son avis, tel quel.
  //
  // Ce n'est pas de la décoration : c'est ce qui permet de juger un faux négatif sans rouvrir la
  // page d'origine. Un avis sans motif oblige à tout revérifier, donc annule le gain.
  motifIa String? @db.Text

  decouvertLe DateTime @default(now())
  majLe       DateTime @updatedAt

  // Par source et par verdict : ce que l'écran filtre. Et par date de début pour l'ordre d'affichage.
  @@index([source, verdict])
  @@index([verdict, debut])
  // Les candidats que l'IA n'a pas encore vus, qui sont précisément ceux qu'un balayage doit
  // prendre : `avisIa IS NULL` combiné au verdict humain.
  @@index([verdict, avisIa])
}

// ⚠️ PAS de valeur « déjà importé » ici, et c'est délibéré.
//
// Qu'un événement soit déjà importé se CALCULE, en comparant son URL aux champs d'origine des
// éditions (`jugglingEdgeUrl`, `facebookUrl`, `officialWebsiteUrl`). Le ranger comme un verdict
// obligerait à le tenir à jour, et il se périmerait au premier import fait depuis un autre écran —
// une donnée fausse mais plausible, qu'aucune alerte ne signalerait.
//
// 📍 `REFUSE` est le verdict d'un HUMAIN, et il est définitif : l'énumération d'une source ne doit
// jamais le réécrire. Quand un agenda re-liste un événement, on met à jour ce qu'il décrit — titre,
// dates, lieu — et on laisse le verdict tel quel. C'est exactement ce que « ne pas me le reproposer
// à chaque fois » demande.
//
// Le verdict d'une classification automatique vit dans ses propres champs (`avisIa`) : il doit
// TRIER sans masquer, pour qu'une convention mal classée reste rattrapable.
enum VerdictCandidat {
  A_EXAMINER // Vu, pas encore jugé
  CONVENTION // Retenu : à importer
  REFUSE // Écarté par un humain, définitivement
}

// L'avis de la classification automatique. Un AVIS, pas une décision.
//
// ⚠️ `INCERTAIN` n'est pas une commodité, c'est le cœur du dispositif. Sans lui, le modèle est
// forcé de trancher sur un titre ambigu — « Festival des Arts du Cirque », qui peut être une
// convention de jonglerie comme un spectacle de rue — et il tranchera, avec aplomb. Une troisième
// valeur rend le doute LISIBLE, et c'est elle qu'un humain va regarder en premier.
//
// 📍 L'absence de valeur (`NULL`) veut dire « pas encore soumis au modèle », et ne se confond donc
// avec aucun avis. C'est ce qui permet à un balayage de reprendre où il s'est arrêté sans
// repasser — et sans refacturer — ce qu'il a déjà vu.
enum AvisIa {
  CONVENTION // Le modèle y voit une convention de jonglerie
  HORS_SUJET // Le modèle n'y voit pas une convention de jonglerie
  INCERTAIN // Le modèle ne tranche pas : à regarder en premier
}
