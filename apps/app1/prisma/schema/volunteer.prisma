// =============================================================================
// Bénévoles — Candidatures, équipes, planning, notifications, commentaires
// =============================================================================

enum VolunteerMode {
  INTERNAL
  EXTERNAL
}

enum DietaryPreference {
  NONE
  VEGETARIAN
  VEGAN
}

enum AllergySeverity {
  LIGHT
  MODERATE
  SEVERE
  CRITICAL
}

enum VolunteerStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum VolunteerApplicationSource {
  APPLICATION // Candidature spontanée via formulaire
  MANUAL // Ajout manuel par un organisateur
}

// Configuration bénévole d'un événement (1:1 avec Event), portée par le layer volunteers.
// Étape 0bis : extraite d'Edition pour que le module bénévole ne dépende plus du domaine jonglerie.
model EventVolunteerSettings {
  eventId Int   @id
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  enabled           Boolean       @default(false)
  open              Boolean       @default(false)
  pagePublic        Boolean       @default(false)
  mode              VolunteerMode @default(INTERNAL)
  // Les échanges de créneaux entre bénévoles, ouverts par défaut : les éditions existantes
  // gardent le comportement qu'elles avaient avant l'arrivée de ce réglage.
  swapsEnabled      Boolean       @default(true)
  // Rattacher des organisateurs aux équipes et créneaux. Fermé par défaut : c'est une
  // possibilité qu'on ouvre, pas un comportement que les éditions existantes attendaient.
  organizersInTeams Boolean       @default(false)
  // Le planning est-il montré aux bénévoles acceptés ?
  //
  // Fermé par défaut, et c'est l'inverse du raisonnement de `swapsEnabled` : un responsable
  // construit ses plannings par itérations, et voir apparaître puis disparaître ses créneaux au
  // fil de la journée donne à un bénévole des informations fausses qu'il notera dans son agenda.
  // Une édition neuve doit donc commencer masquée, et le responsable publier quand il juge prêt.
  //
  // ⚠️ La MIGRATION passe toutes les lignes EXISTANTES à `true`. Le défaut sert les éditions à
  // venir ; sans cet UPDATE, les éditions en cours perdraient du jour au lendemain un affichage
  // que leurs bénévoles ont déjà — y compris pendant une convention.
  planningPublished Boolean       @default(false)
  description       String?       @db.Text
  externalUrl       String?
  setupStartDate    DateTime?
  teardownEndDate   DateTime?
  updatedAt         DateTime?

  // Questions du formulaire de candidature
  askDiet             Boolean @default(false)
  askAllergies        Boolean @default(false)
  askTimePreferences  Boolean @default(false)
  askTeamPreferences  Boolean @default(false)
  askPets             Boolean @default(false)
  askMinors           Boolean @default(false)
  askVehicle          Boolean @default(false)
  askCompanion        Boolean @default(false)
  askAvoidList        Boolean @default(false)
  askSkills           Boolean @default(false)
  askExperience       Boolean @default(false)
  askEmergencyContact Boolean @default(false)
  askSetup            Boolean @default(false)
  askTeardown         Boolean @default(false)
}

model EditionVolunteerApplication {
  id                   Int                         @id @default(autoincrement())
  eventId              Int
  userId               Int
  status               VolunteerStatus             @default(PENDING)
  motivation           String?                     @db.Text
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  decidedAt            DateTime?
  userSnapshotPhone    String?
  timePreferences      Json?
  teamPreferences      Json?
  acceptanceNote       String?                     @db.Text
  hasPets              Boolean?
  petsDetails          String?                     @db.Text
  hasMinors            Boolean?
  minorsDetails        String?                     @db.Text
  hasVehicle           Boolean?
  vehicleDetails       String?                     @db.Text
  companionName        String?                     @db.Text
  avoidList            String?                     @db.Text
  skills               String?                     @db.Text
  hasExperience        Boolean?
  experienceDetails    String?                     @db.Text
  setupAvailability    Boolean?
  teardownAvailability Boolean?
  eventAvailability    Boolean?
  arrivalDateTime      String?
  departureDateTime    String?
  qrCodeToken          String?                     @unique
  entryValidated       Boolean                     @default(false)
  entryValidatedAt     DateTime?
  entryValidatedBy     Int?
  source               VolunteerApplicationSource  @default(APPLICATION)
  addedById            Int?
  addedAt              DateTime?
  event                Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedBy              User?                       @relation("ManuallyAddedVolunteers", fields: [addedById], references: [id], onDelete: SetNull)
  teamAssignments      ApplicationTeamAssignment[]
  mealSelections       VolunteerMealSelection[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([status])
  @@index([userId], map: "EditionVolunteerApplication_userId_fkey")
  @@index([entryValidated])
  @@index([source])
  @@index([addedById])
  @@index([qrCodeToken])
}

// ========== NOTIFICATIONS BÉNÉVOLES ==========

model VolunteerNotificationGroup {
  id             String   @id @default(cuid())
  eventId        Int
  senderId       Int
  title          String
  message        String   @db.Text
  targetType     String // 'all' ou 'teams'
  selectedTeams  Json? // Array des équipes sélectionnées si targetType = 'teams'
  recipientCount Int
  sentAt         DateTime @default(now())

  event         Event                               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sender        User                                @relation(fields: [senderId], references: [id])
  confirmations VolunteerNotificationConfirmation[]

  @@index([eventId])
  @@index([senderId])
}

model VolunteerNotificationConfirmation {
  id                           String    @id @default(cuid())
  volunteerNotificationGroupId String
  userId                       Int
  confirmedAt                  DateTime?

  notificationGroup VolunteerNotificationGroup @relation(fields: [volunteerNotificationGroupId], references: [id], onDelete: Cascade)
  user              User                       @relation(fields: [userId], references: [id])

  @@unique([volunteerNotificationGroupId, userId])
  @@index([userId])
}

// ========== PLANNING BÉNÉVOLES ==========

model VolunteerTeam {
  id                    String   @id @default(cuid())
  eventId               Int
  name                  String
  description           String?  @db.Text
  color                 String   @default("#6b7280") @db.VarChar(7)
  maxVolunteers         Int?
  isRequired            Boolean  @default(false)
  isAccessControlTeam   Boolean  @default(false)
  isMealValidationTeam  Boolean  @default(false)
  /// Équipe de bénévoles VOLANTS : des gens à disposition, sans créneau fixe, qu'on appelle en
  /// renfort quand une équipe prend du retard ou qu'une tâche se révèle plus lourde que prévu.
  ///
  /// La notion vit sur l'ÉQUIPE et non sur le bénévole, et c'est ce qui la rend peu coûteuse :
  /// être volant, c'est simplement appartenir à une telle équipe. Le rattachement existe déjà
  /// (`ApplicationTeamAssignment`), les objets à remettre sont déjà portés par l'équipe, et la
  /// conversation d'équipe permet déjà de joindre tout le monde pendant l'événement.
  ///
  /// ⚠️ Elle n'exempte de rien à elle seule. Un bénévole n'est « hors des comptes » que si TOUTES
  /// ses équipes sont volantes : quelqu'un qui est à la fois en cuisine et volant reste un
  /// bénévole ordinaire, et l'assignation automatique lui donne ses heures de cuisine. Voir
  /// `benevoles-volants.ts`, où la règle est écrite une fois.
  isFloatingTeam        Boolean  @default(false)
  /// Équipe AUTONOME : elle se gère à part, et réserve ses membres.
  ///
  /// Ses créneaux ne comptent pas dans les heures à pourvoir et ne sont pas remplis par
  /// l'assignation automatique — elle s'organise elle-même. Et les bénévoles qui n'appartiennent
  /// qu'à des équipes autonomes ne reçoivent aucun créneau d'ailleurs : ils lui sont réservés.
  ///
  /// ⚠️ À ne pas confondre avec `isFloatingTeam`, dont l'effet sur l'ÉQUIPE est le même mais dont
  /// l'effet sur les PERSONNES est inverse : la volante libère ses membres de leur volume
  /// d'heures et les propose en renfort, l'autonome les garde tenus à leurs heures et les tient
  /// hors de la page des renforts. Voir `benevoles-volants.ts`, où les deux règles cohabitent.
  isAutonomousTeam      Boolean  @default(false)
  isVisibleToVolunteers Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  event                Event                         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  timeSlots            VolunteerTimeSlot[]
  assignedApplications ApplicationTeamAssignment[]
  assignedOrganizers   OrganizerTeamAssignment[]
  handoutItems         EditionVolunteerHandoutItem[]
  conversations        Conversation[]

  @@index([eventId])
}

model VolunteerTimeSlot {
  id            String   @id @default(cuid())
  eventId       Int
  teamId        String?
  title         String?
  description   String?  @db.Text
  startDateTime DateTime
  endDateTime   DateTime
  maxVolunteers Int      @default(1)
  delayMinutes  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event                Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team                 VolunteerTeam?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignments          VolunteerAssignment[]
  organizerAssignments OrganizerSlotAssignment[]

  @@index([eventId])
  @@index([teamId])
}

/// D'où vient une affectation : posée à la main, ou produite par l'assignation automatique.
/// `assignedById` ne peut pas en tenir lieu — l'organisateur qui lance le calcul y figure
/// comme s'il avait tout posé lui-même.
///
/// Sert aux deux choses que l'assignation automatique écrit, et qu'elle doit donc pouvoir
/// reprendre sans écraser de décision humaine : l'affectation à un créneau
/// (`VolunteerAssignment`) et le rattachement à une équipe (`ApplicationTeamAssignment`).
enum VolunteerAssignmentSource {
  MANUAL
  AUTO
}

model VolunteerAssignment {
  id           String                    @id @default(cuid())
  timeSlotId   String
  userId       Int
  assignedAt   DateTime                  @default(now())
  assignedById Int
  // Par défaut manuelle : c'est le choix prudent pour les lignes déjà en base, dont l'origine
  // est perdue, et une relance ne doit pas les balayer par surprise.
  source       VolunteerAssignmentSource @default(MANUAL)

  timeSlot       VolunteerTimeSlot      @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  user           User                   @relation("VolunteerAssignment_user", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy     User                   @relation("VolunteerAssignment_assignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  swapsOffered   VolunteerSwapRequest[] @relation("VolunteerSwap_requesterAssignment")
  swapsRequested VolunteerSwapRequest[] @relation("VolunteerSwap_targetAssignment")

  @@unique([timeSlotId, userId])
  @@index([timeSlotId])
  @@index([userId])
  @@index([assignedById])
  // La relance efface les affectations automatiques d'une édition : cet index évite un
  // balayage complet de la table pour les retrouver.
  @@index([source])
}

/// Le journal d'une application de l'assignation automatique, et de quoi la défaire.
///
/// Le calcul écrit des centaines de lignes d'un coup et n'en gardait aucune trace : ni les
/// réglages employés, ni ce qu'il avait effacé, ni qui l'avait lancé — deux `console.log` en tout.
/// Un organisateur qui se trompait de mode n'avait aucun moyen de revenir en arrière.
///
/// L'état antérieur est conservé en JSON plutôt qu'en tables filles, et c'est délibéré : il est
/// écrit d'un bloc, relu d'un bloc au moment d'annuler, et n'est jamais interrogé autrement. Deux
/// tables de plus n'apporteraient que des jointures.
///
/// ⚠️ Seul le dernier journal d'une édition peut être annulé, et une seule fois. Défaire un calcul
/// par-dessus un autre reviendrait à restaurer un état que le suivant a déjà modifié.
model VolunteerAutoAssignRun {
  id           String   @id @default(cuid())
  eventId      Int
  executedById Int
  executedAt   DateTime @default(now())
  /// `replace-all`, `keep-all` ou `keep-manual`.
  mode         String
  /// Les contraintes telles que l'organisateur les avait réglées, pour savoir ce qui a produit ce
  /// planning — la question que l'on se pose toujours en second.
  constraints  Json

  /// Ce que le calcul a effacé, tel que c'était : de quoi le recréer à l'identique.
  deletedAssignments Json
  /// Ce qu'il a créé : de quoi le retirer.
  createdAssignments Json
  /// Les rattachements d'équipe, sur le même principe.
  deletedTeamLinks   Json
  createdTeamLinks   Json

  createdCount Int
  deletedCount Int

  /// Renseignés quand le calcul a été annulé. Un journal annulé ne l'est pas deux fois.
  undoneAt   DateTime?
  undoneById Int?

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  executedBy User  @relation("VolunteerAutoAssignRun_executedBy", fields: [executedById], references: [id], onDelete: Cascade)
  undoneBy   User? @relation("VolunteerAutoAssignRun_undoneBy", fields: [undoneById], references: [id], onDelete: SetNull)

  @@index([eventId, executedAt])
  @@index([executedById])
  @@index([undoneById])
}

// ========== ASSIGNATION ÉQUIPES BÉNÉVOLES ==========

model ApplicationTeamAssignment {
  applicationId Int
  teamId        String
  isLeader      Boolean                   @default(false)
  assignedAt    DateTime                  @default(now())
  /// D'où vient ce rattachement : d'un organisateur, ou d'un calcul d'assignation automatique.
  ///
  /// Sans cette colonne, « tout effacer et recalculer » emportait les équipes attribuées à la
  /// main — une décision que rien ne reconstruit, et dont le calcul se sert pourtant pour scorer
  /// (`assignedTeams`, bonus d'équipe, mode strict). Le pendant exact de `VolunteerAssignment.source`.
  ///
  /// Par défaut manuelle, pour la même raison qu'elle : l'origine des lignes déjà en base est
  /// perdue, et une relance ne doit pas les balayer par surprise.
  source        VolunteerAssignmentSource @default(MANUAL)

  application EditionVolunteerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  team        VolunteerTeam               @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([applicationId, teamId])
  @@index([teamId])
  @@index([isLeader])
  /// La relance efface les rattachements automatiques : cet index évite un balayage complet.
  @@index([source])
}

/// Rattachement d'un organisateur d'édition à une équipe de bénévoles.
///
/// Table distincte de `ApplicationTeamAssignment`, et non un champ ajouté à celle-ci : un
/// organisateur n'a pas de candidature, et la table des candidatures ne saurait donc pas le
/// porter. Séparer les deux évite d'inventer des candidatures fantômes pour des gens qui n'en
/// ont jamais déposé.
model OrganizerTeamAssignment {
  editionOrganizerId Int
  teamId             String
  /// Un organisateur peut piloter une équipe, au même titre qu'un bénévole responsable — et
  /// avec les mêmes droits, qui ne dépendent donc plus d'une candidature acceptée.
  isLeader           Boolean  @default(false)
  assignedAt         DateTime @default(now())

  editionOrganizer EditionOrganizer @relation(fields: [editionOrganizerId], references: [id], onDelete: Cascade)
  team             VolunteerTeam    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([editionOrganizerId, teamId])
  @@index([teamId])
  @@index([isLeader])
}

/// Affectation d'un organisateur d'édition à un créneau de bénévolat.
///
/// Table distincte de `VolunteerAssignment`, mais pas parce qu'un organisateur pèserait moins :
/// il occupe une place comme un bénévole, et `maxVolunteers` les compte ensemble. Ce qui le
/// distingue est ailleurs — il n'a ni candidature, ni échange de créneau, ni part dans
/// l'assignation automatique.
///
/// Sans `assignedById`, contrairement à `VolunteerAssignment` : cette traçabilité y sert aux
/// échanges et à distinguer les affectations automatiques, deux mécaniques dont les
/// organisateurs sont hors de portée.
model OrganizerSlotAssignment {
  editionOrganizerId Int
  timeSlotId         String
  assignedAt         DateTime @default(now())

  editionOrganizer EditionOrganizer  @relation(fields: [editionOrganizerId], references: [id], onDelete: Cascade)
  timeSlot         VolunteerTimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)

  @@id([editionOrganizerId, timeSlotId])
  @@index([timeSlotId])
}

model VolunteerComment {
  id        Int      @id @default(autoincrement())
  userId    Int
  eventId   Int
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

// ========== ÉCHANGE DE CRÉNEAUX ENTRE BÉNÉVOLES ==========

/// Où en est une demande d'échange.
///
/// Deux accords sont nécessaires avant d'y toucher : celui du bénévole visé, puis celui d'un
/// organisateur. Un planning se déséquilibre vite, et l'échange qui arrange deux personnes peut
/// dégarnir un poste que ni l'une ni l'autre ne voit.
enum VolunteerSwapStatus {
  /// En attente de la réponse du bénévole visé.
  PENDING_PEER
  /// Les deux bénévoles sont d'accord ; un organisateur doit trancher.
  PENDING_MANAGER
  ACCEPTED
  /// Refusée par le bénévole visé ou par l'organisateur.
  REFUSED
  /// Retirée par le demandeur.
  CANCELLED
  /// L'un des deux créneaux est passé : l'échange n'a plus d'objet.
  EXPIRED
}

/// Demande d'échange d'un créneau contre un autre, entre deux bénévoles.
///
/// Un pour un : le demandeur offre l'une de ses affectations et en convoite une autre. Prendre un
/// créneau libre ou abandonner le sien sans contrepartie ne passe pas par ici.
///
/// Les deux affectations sont référencées par leur identifiant, en `Cascade` : si l'une disparaît
/// — désaffectation manuelle, relance de l'assignation automatique — la demande s'efface avec
/// elle. C'est le comportement voulu : elle porterait sur un créneau que plus personne ne tient.
model VolunteerSwapRequest {
  id                    String              @id @default(cuid())
  eventId               Int
  requesterId           Int
  targetId              Int
  /// Affectation offerte par le demandeur.
  requesterAssignmentId String
  /// Affectation convoitée, tenue par la cible.
  targetAssignmentId    String
  status                VolunteerSwapStatus @default(PENDING_PEER)
  /// Quand la cible a répondu, quel que soit son sens.
  peerRespondedAt       DateTime?
  /// L'organisateur qui a tranché, et quand.
  decidedById           Int?
  decidedAt             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  event               Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requester           User                @relation("VolunteerSwap_requester", fields: [requesterId], references: [id], onDelete: Cascade)
  target              User                @relation("VolunteerSwap_target", fields: [targetId], references: [id], onDelete: Cascade)
  decidedBy           User?               @relation("VolunteerSwap_decidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  requesterAssignment VolunteerAssignment @relation("VolunteerSwap_requesterAssignment", fields: [requesterAssignmentId], references: [id], onDelete: Cascade)
  targetAssignment    VolunteerAssignment @relation("VolunteerSwap_targetAssignment", fields: [targetAssignmentId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@index([requesterId])
  @@index([targetId])
  @@index([requesterAssignmentId])
  @@index([targetAssignmentId])
  @@index([decidedById])
}
