# Variables d'environnement pour Portainer Stack
# Copiez ces variables dans les "Environment variables" de votre stack

# Base de données
#
# ⚠️ LE MOT DE PASSE S'ÉCRIT EN CLAIR ICI, sans rien encoder. C'est `docker/entrypoint.sh` qui
# construit DATABASE_URL, avec `encodeURIComponent` — donc une ponctuation quelconque (« @ »,
# « / », « : », « # », « % », un espace) passe sans que vous ayez à y penser.
#
# Ce n'était pas le cas avant : le compose interpolait ce mot de passe TEL QUEL dans l'URL, et un
# « @ » suffisait à la rendre illisible. L'application échouait alors au démarrage sur « Access
# denied » ou sur un hôte introuvable, sans qu'aucun message ne désigne le vrai coupable.
#
# NE DÉFINISSEZ PAS DATABASE_URL ici : l'entrypoint respecte une valeur explicite et cesse alors de
# la construire. Si vous devez malgré tout la fournir — base gérée, hôte externe, réplique —, alors
# c'est à VOUS d'encoder l'utilisateur, le mot de passe et le nom de base :
#   node -e 'console.log(encodeURIComponent("p@ss/w%rd"))'   →   p%40ss%2Fw%25rd
MYSQL_ROOT_PASSWORD=changeme123
MYSQL_DATABASE=convention_db
MYSQL_USER=convention_user
MYSQL_PASSWORD=changeme456

# Application
JWT_SECRET=your-super-secret-jwt-key-32-chars-minimum
APP_URL=http://localhost:3000

# Ports (optionnel si vous voulez changer les ports par défaut)
APP_PORT=3000
DB_PORT=3306


SEND_EMAILS=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-smtp-password"

NUXT_FILE_STORAGE_MOUNT="/uploads"

# ReCAPTCHA (pour formulaires de contact, etc.)
NUXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-site-key"
NUXT_RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"

# Google OAuth (optionnel, pour tests en local)
NUXT_OAUTH_GOOGLE_CLIENT_ID="your-google-client-id"
NUXT_OAUTH_GOOGLE_CLIENT_SECRET="your-google-client-secret"
NUXT_OAUTH_GOOGLE_REDIRECT_URL="http://localhost:3000/auth/google"

# Facebook OAuth (optional, pour tests en local)
NUXT_OAUTH_FACEBOOK_CLIENT_ID="your-facebook-app-id"
NUXT_OAUTH_FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"
NUXT_OAUTH_FACEBOOK_REDIRECT_URL="http://localhost:3000/auth/facebook"

# Firebase Web (Client) - Configuration publique
NUXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NUXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NUXT_PUBLIC_FIREBASE_VAPID_KEY=your-firebase-vapid-public-key

# Firebase Admin (Serveur) - Configuration privée
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-content\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

ENABLE_CRON=true

# Encryption for sensitive data (HelloAsso client secrets, etc.)
ENCRYPTION_SECRET="change-this-to-a-strong-random-secret-key-min-32-chars"
ENCRYPTION_SALT="change-this-salt-to-random-value"

# URL de l'API HelloAsso (par défaut: https://api.helloasso.com)
HELLOASSO_API_URL="https://www.helloasso-sandbox.com"

# Provider IA à utiliser
AI_PROVIDER=lmstudio

# API Anthropic Claude (pour IA et analyse d'images)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Note: La configuration LM Studio (URL, modèles) est gérée via /admin/ai-config
# et stockée en base de données.

# Browserless (scraping de pages web avec JavaScript rendu)
# Permet de récupérer le contenu des pages après exécution du JavaScript (Facebook, SPAs, etc.)
# Stack Docker à déployer séparément : browserless/chrome
BROWSERLESS_URL=http://your-browserless-host:3001

# Environnement du site, lu À L'EXÉCUTION par @nuxtjs/seo.
# Toute valeur autre que `production` rend le site non indexable : robots.txt passe en
# `Disallow: /` et l'en-tête X-Robots-Tag en `noindex`.
# À poser sur release/staging UNIQUEMENT — l'omettre en production.
#   NUXT_SITE_ENV=staging
#
# Ne pas confondre avec NUXT_ENV, qui sert à autoriser des actions réservées aux environnements
# de test (anonymisation des comptes). NUXT_ENV n'a aucun effet sur l'indexation : il était lu au
# build, où aucune variable n'arrive.

# Empreinte SHA-256 de la clé qui signe l'application Android du Play Store.
#
# Sert à composer /.well-known/assetlinks.json, le fichier qui atteste que ce domaine et
# l'application sont la même chose. SANS LUI, l'application s'ouvre avec la barre d'adresse de
# Chrome par-dessus — aucune erreur, aucun journal, juste une barre d'adresse — et une application
# qui ressemble à un navigateur déguisé se fait refuser à l'examen du Play Store.
#
# ⚠️ C'est l'empreinte de GOOGLE, pas la vôtre. Avec « Play App Signing », la clé qui signe
# l'application livrée est détenue par Google ; celle que vous gardez ne sert qu'à ENVOYER. Relevez
# la bonne dans la console Play, sous « Intégrité de l'application › Signature d'application »,
# après le premier envoi.
#
# ⚠️ Prenez la SHA-256, pas la SHA-1 affichée juste à côté : elles se ressemblent, et la seconde ne
# fait que vingt octets. Une empreinte au mauvais format est écartée plutôt que publiée, ce qui
# donne le même symptôme qu'une variable oubliée.
#
# Plusieurs empreintes se séparent par une virgule (le temps d'une rotation de clé).
# Laisser vide tant que l'application n'a pas été déposée : cf. docs/publication-play-store-twa.md
#   ANDROID_SIGNING_FINGERPRINTS=14:6D:E9:...:44:E5
