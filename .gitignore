# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea
.history

# État local de la commande /check-error-logs
.claude/error-logs-monitor.json

# Sauvegarde du hash bcrypt écrite par scripts/_temp-password-swap.ts, le temps d'un échange de
# mot de passe en développement. ⚠️ Elle n'était PAS ignorée : un `git add -A` l'aurait commitée,
# et le hash d'un vrai compte serait entré dans l'historique du dépôt — d'où il ne sort plus.
.pwd-swap-backup.json
apps/app1/.pwd-swap-backup.json

# Test coverage
coverage

# Local env files
.env
.env.*
!.env.example
!.env.docker.example
!.env.portainer.example

/server/generated/prisma

# Uploaded files
public/uploads/
!public/uploads/.gitkeep

# Backup folder (local development)
/backup
/backups/*
i18n/locales-backup/

# Translation config files (generated)
scripts/translation/translations-config.json
scripts/translation/translations-config.template.json
scripts/translation/todo-*.json

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

!.gitkeep

# Variables de stack Portainer : écrites par Portainer sur l'hôte de déploiement, jamais dans le
# dépôt. Ignorées ici pour qu'un fichier créé par mégarde en local (validation d'un compose, par
# exemple) ne parte pas dans un commit avec les secrets de production.
stack.env
